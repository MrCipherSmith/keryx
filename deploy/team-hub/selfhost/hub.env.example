# <install dir>/secrets/hub.env — written by install.sh, owner-only (0600).
# This file is the whole per-install configuration; releases/<tag>/ holds
# everything that changes with a version. This example only documents the keys.
# Never commit the real file, and never paste it into a ticket or a chat.

# --- Secrets. Independent random values (openssl rand -hex 32); at least 32 characters.
# Signs a human in to the web UI and owns approvals. Shown once by install.sh.
KERYX_HUB_OPERATOR_TOKEN=
# The Hub's bootstrap agent credential. Unscoped: do not hand it to a client.
# Give clients named, project-scoped keys instead: `hubctl agent-key issue`.
KERYX_HUB_AGENT_TOKEN=
# Optional third, independent human token for a second reviewer.
KERYX_HUB_REVIEWER_TOKEN=

# --- Reachability.
# local | https | cloudflare. Chosen at install time.
KERYX_HUB_MODE=local
# The exact browser origin (scheme + host, no path, no trailing slash). Empty in
# `local` mode. The Hub allows non-loopback traffic only when this is https.
KERYX_HUB_PUBLIC_ORIGIN=
# Public DNS name (https, cloudflare modes).
HUB_DOMAIN=
# Optional Let's Encrypt contact (https mode).
ACME_EMAIL=
# The Hub's loopback port on the host.
HUB_PORT=8787

# --- Cloudflare mode.
CF_TUNNEL_ID=
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# --- Backups kept on this server, rotated by `hubctl backup`.
KERYX_HUB_BACKUP_DAILY=14
KERYX_HUB_BACKUP_WEEKLY=8
