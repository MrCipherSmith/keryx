tunnel: @CF_TUNNEL_ID@
credentials-file: /run/secrets/tunnel.json
metrics: 127.0.0.1:20241
ingress:
  - hostname: @HUB_DOMAIN@
    service: http://edge:8080
    originRequest:
      access:
        required: true
        teamName: @CF_ACCESS_TEAM@
        audTag:
          - @CF_ACCESS_AUD@
  - service: http_status:404
