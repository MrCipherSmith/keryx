# Copy to .env (do not commit), chmod 600, generate independent values:
# openssl rand -hex 32   # run once per token; never reuse human token for agents
KERYX_HUB_OPERATOR_TOKEN=
KERYX_HUB_AGENT_TOKEN=
# Optional third independent human reviewer token:
KERYX_HUB_REVIEWER_TOKEN=
HUB_PORT=8787
# For HTTPS profile: set your actual public DNS name and exact browser origin.
# HUB_DOMAIN=hub.your-domain.tld
# KERYX_HUB_PUBLIC_ORIGIN=https://hub.your-domain.tld
KERYX_HUB_PUBLIC_ORIGIN=
# Optional named agent allowlist. Mount its parent directory read-only and use
# an owner-only regular JSON file (0600); store tokenDigest SHA256 values only.
# KERYX_HUB_AGENT_CREDENTIALS_FILE=/run/keryx-agents/agents.json
