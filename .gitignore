node_modules/
dist/
coverage/
.site/
.DS_Store
.tmp-*/
*.vsix

# Agent-harness scratch space. `.claude/worktrees/` holds git worktrees — full
# checkouts of this repository — which must never be committed or source-indexed
# (see IGNORE_DIRS in src/gdgraph/build.ts). Committed here rather than left in
# the machine-local .git/info/exclude so every contributor gets it.
# `.claude/settings.json` stays tracked on purpose, so this is not a blanket
# `.claude/` ignore.
.claude/worktrees/

# Retrieval-measurement output. Holds one full checkout per arm while a task
# runs — a fifty-task sweep creates a hundred of them — plus the raw per-arm
# results. The results that matter are copied into
# docs/requirements/keryx-context-measurement/data/ deliberately; everything
# here is working space and must never be committed or source-indexed.
.benchmark-runs/



# Slate v3 (SLATE-22..26): external-hand slate storage — private, task-local
# working memory an MCP-connected external hand (Claude Code, Codex, ...)
# opens for itself via `slate.open`/`slate.writeSeed`/`slate.close`. Always
# project-scoped, never `.metaproject/`, never committed — unlike the
# neighboring `.keryx/sandbox-policy.json` (a project policy file meant to be
# trackable), so this ignores only the `external-slates/` subpath, not all of
# `.keryx/`.
.keryx/external-slates/

# MCP client config, written by `keryx integrate`. It embeds the ABSOLUTE path
# of the project on the machine that ran the install (`--cwd /home/you/keryx`),
# so a committed copy is correct on exactly one machine and silently dead on
# every other. It was committed once, with a macOS path, and sat broken on Linux
# from 2026-08-13 until it was noticed on 2026-09-02 — the server simply never
# started, and nothing said so. Re-run `keryx integrate claude` to regenerate it
# locally.
.mcp.json

# keryx-shell-benchmark harness: raw run output (thousands of per-scenario
# files), not curated docs. Keep locally for analysis; do not commit.
docs/requirements/keryx-shell-benchmark/harness/logs/
docs/requirements/keryx-shell-benchmark/harness/runs/
docs/requirements/keryx-shell-benchmark/harness/__pycache__/

# Context-measurement run output, written by scripts/benchmark/retrieval-*.ts.
# Per-arm transcripts and per-task artifacts, some of them checkouts of OTHER
# repositories the measurement ran against. Untracked but not ignored is not a
# safe state for that: one `git add -A` puts another project's material into
# this public repository's history, where deleting it later does not remove it.
.benchmark-runs/

# keryx:begin
# Metaproject: keep agent-facing context versioned, ignore executable/generated internals.
.metaproject/runtime/
.metaproject/core/**/*.ts
.metaproject/data/**/storage/
.metaproject/data/**/raw/
.metaproject/data/**/queries/
.metaproject/data/**/summaries/
.metaproject/data/gdctx/artifacts/
.metaproject/data/gdwiki/artifacts/
.metaproject/data/gdwiki/link-check/
.metaproject/data/health/history/
.metaproject/data/health/artifacts/latest.md
.metaproject/data/health/artifacts/latest.json
.metaproject/data/testing/history/
.metaproject/data/testing/logs/
.metaproject/data/testing/artifacts/latest.md
.metaproject/data/testing/artifacts/latest.json
.metaproject/data/tasks/runtime/
.metaproject/data/tasks/logs/
.metaproject/flows/.flow-init.lock/
.metaproject/flows/.flow-lock-*/
# Memory generated views, caches, reports, and atomic staging are disposable.
.metaproject/data/memory/index/
.metaproject/data/memory/embeddings/
.metaproject/data/memory/artifacts/
.metaproject/runtime/memory/
# Security: local-only HMAC key, self-protect state, and local hash report must never be committed.
.metaproject/data/security/raw/
.metaproject/data/security/raw/**
.metaproject/data/security/artifacts/latest.md
.metaproject/data/security/artifacts/latest.json
# Forgetting/retention runtime state: the auto-sweep stamp is rewritten by the
# gdctx write path on every call, not a project artifact. These lines were added
# to this repository's .gitignore by hand INSIDE the managed block, where the
# next `keryx update` regenerated them away — which is how they came to belong
# here instead.
.metaproject/data/forgetting/
.metaproject/data/retention/
.metaproject/reports/
# keryx:end

# mutation-sweep working state. The journal names the file that may still
# be mutated if the run is killed; the progress file is how a backgrounded
# run is watched, since Bun buffers stdout to a pipe.
.mutation-sweep-journal
.mutation-sweep-progress
