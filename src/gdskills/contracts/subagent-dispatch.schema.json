{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keryx.local/schemas/gdskills/subagent-dispatch.schema.json",
  "title": "Metaproject Subagent Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "dispatch_id",
    "orchestrator",
    "target_skill",
    "task",
    "acceptance_criteria",
    "context_refs",
    "files_to_read",
    "constraints",
    "allowed_actions",
    "output_contract",
    "budget",
    "provenance"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "dispatch_id": { "type": "string", "minLength": 1 },
    "parent_dispatch_id": { "type": ["string", "null"] },
    "orchestrator": { "type": "string", "minLength": 1 },
    "target_skill": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "intent": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "context_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_ref" }
    },
    "files_to_read": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read", "write", "run-command", "network", "git", "ask-user", "spawn-subagent", "peer"]
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_path"],
      "properties": {
        "schema": { "type": "string" },
        "artifact_path": { "type": "string" },
        "summary_max_tokens": { "type": "integer", "minimum": 50 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_prompt_tokens": { "type": ["integer", "null"], "minimum": 1000 },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 500 },
        "max_runtime_ms": { "type": ["integer", "null"], "minimum": 1000 },
        "max_findings": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "inherit": { "type": "boolean" }
      }
    },
    "runtime": {
      "description": "Which child runtime executes this dispatch (flow 176; docs/requirements/keryx-external-agent-runtime). Additive and optional: an absent block means the native keryx runtime, so every dispatch authored before this package stays valid. Constraints this schema cannot express — the agent resolving in the registry, the sandbox appearing in that agent's supported modes, and read-only versus allowed_actions — are enforced fail-closed by the pure validator in src/harness/external/dispatch.ts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "description": "`keryx` runs the in-process agent loop; `external` spawns a vendor CLI subprocess.",
          "type": "string",
          "enum": ["keryx", "external"]
        },
        "agent": {
          "description": "Registry id of the external agent. Required when kind is `external`.",
          "type": "string",
          "minLength": 1
        },
        "sandbox": {
          "description": "Permission level for the external child. `worktree-write` is schema-valid but refused at runtime in the read-only release, with a reason distinguishable from an unsupported-by-this-agent refusal.",
          "type": "string",
          "enum": ["read-only", "worktree-write"]
        },
        "model": {
          "description": "Model id passed to the external CLI. Omit or null to let the CLI resolve its own default under the operator's active subscription — keryx never pins a model the account may not be entitled to.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "timeoutMs": { "type": ["integer", "null"], "minimum": 1000 },
        "maxCostUnits": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "external" } }, "required": ["kind"] },
          "then": { "required": ["agent", "sandbox"] }
        },
        {
          "if": { "properties": { "kind": { "const": "keryx" } }, "required": ["kind"] },
          "then": { "not": { "required": ["agent"] } }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["created_at", "created_by"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string" },
        "source_request": { "type": "string" }
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "exists"],
      "properties": {
        "path": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["context", "graph", "wiki", "memory", "health", "diff", "report", "plan", "review", "custom"]
        },
        "exists": { "type": "boolean" },
        "summary": { "type": "string" },
        "hash": { "type": ["string", "null"] }
      }
    }
  }
}
