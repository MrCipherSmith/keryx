+import { expect, test } from "bun:test";
+import { mkdtemp, readFile, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { renderExecutionPlanChangelog, setExecutionPlan, updateExecutionPlan, type ExecutionPlan } from "./execution-plan";
+import { diffExecutionPlans, ExecutionPlanHistory, planHistoryCursorPath, planHistoryPath, type PlanTransition } from "./execution-plan-history";
+
+async function bareDir(): Promise<string> {
+  return mkdtemp(join(tmpdir(), "keryx-plan-history-"));
+}
+
+test("diffExecutionPlans reports added, renamed, status, reordered and removed items", () => {
+  const previous: ExecutionPlan = { revision: 1, items: [
+    { id: "a", title: "Alpha", status: "pending" },
+    { id: "b", title: "Beta", status: "pending" },
+    { id: "c", title: "Gamma", status: "pending" },
+  ] };
+  const next: ExecutionPlan = { revision: 2, items: [
+    { id: "b", title: "Beta", status: "in_progress" },
+    { id: "a", title: "Alpha (narrowed)", status: "pending" },
+    { id: "d", title: "Delta", status: "proposed" },
+  ] };
+  const out: PlanTransition[] = [];
+  diffExecutionPlans(previous, next, out);
+  expect(out.map((change) => `${change.kind}:${change.itemId}`)).toEqual([
+    "status:b", "reordered:b", "renamed:a", "reordered:a", "added:d", "removed:c",
+  ]);
+});
+
+test("every plan write is journaled and the changelog renders it", async () => {
+  const dir = await bareDir();
+  await setExecutionPlan(dir, { expectedRevision: 0, items: [
+    { id: "one", title: "First", status: "pending" },
+    { id: "two", title: "Second", status: "pending" },
+  ] });
+  await updateExecutionPlan(dir, { expectedRevision: 1, itemId: "one", status: "in_progress" });
+
+  const history = new ExecutionPlanHistory(dir);
+  expect(history.entries.map((entry) => entry.revision)).toEqual([1, 2]);
+  expect(history.changesFor("one").map((change) => change.kind)).toEqual(["added", "status"]);
+
+  const changelog = renderExecutionPlanChangelog(dir, 1);
+  expect(changelog).toContain("revision 2");
+  expect(changelog).toContain("* one pending -> in_progress");
+  expect(changelog).not.toContain("+ two");
+});
+
+test("a write that changes nothing adds no journal line", async () => {
+  const dir = await bareDir();
+  const items = [{ id: "x", title: "Only", status: "pending" as const }];
+  await setExecutionPlan(dir, { expectedRevision: 0, items });
+  await setExecutionPlan(dir, { expectedRevision: 1, items });
+  const lines = (await readFile(planHistoryPath(dir), "utf8")).trim().split("\n");
+  expect(lines).toHaveLength(1);
+  expect(renderExecutionPlanChangelog(dir, 1)).toBeUndefined();
+});
+
+test("entries past the cursor are not reported as history", async () => {
+  const dir = await bareDir();
+  await setExecutionPlan(dir, { expectedRevision: 0, items: [{ id: "x", title: "Only", status: "pending" }] });
+  await writeFile(planHistoryCursorPath(dir), `${JSON.stringify({ revision: 0 })}\n`);
+  expect(new ExecutionPlanHistory(dir).entries).toEqual([]);
+});
+
+test("a corrupt cursor fails with the file it came from", async () => {
+  const dir = await bareDir();
+  await writeFile(planHistoryCursorPath(dir), "{not json");
+  expect(() => new ExecutionPlanHistory(dir)).toThrow(planHistoryCursorPath(dir));
+});
diff --git a/src/session/execution-plan-history.ts b/src/session/execution-plan-history.ts
