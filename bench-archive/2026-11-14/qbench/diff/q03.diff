+
+/**
+ * What changed in the plan after `sinceRevision`, newest revision last, for the
+ * operator catching up on a session. `undefined` when nothing was recorded since.
+ */
+export function renderExecutionPlanChangelog(dir: string, sinceRevision = 0, maxEntries = 10): string | undefined {
+  const history = new ExecutionPlanHistory(dir);
+  const entries = history.since(sinceRevision);
+  if (entries.length === 0) return undefined;
+  const shown = entries.slice(-Math.max(1, maxEntries));
+  const blocks = shown.map((entry) => [
+    `revision ${entry.revision} (${entry.at})`,
+    ...entry.transitions.map((change) => `  ${describeChange(change)}`),
+  ].join("\n"));
+  const skipped = entries.length - shown.length;
+  const header = `Execution plan changes since revision ${sinceRevision} (latest ${history.latestRevision}):`;
+  return [header, ...(skipped > 0 ? [`… ${skipped} earlier revision(s) omitted`] : []), ...blocks].join("\n");
+}
