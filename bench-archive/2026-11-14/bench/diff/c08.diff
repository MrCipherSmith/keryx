+    for (const line of frame.lines) {
+      for (const span of line.spans) {
+        const asFg = themeColorToHex(span.fg);
+        if (asFg !== undefined) fg.add(asFg);
+        const asBg = themeColorToHex(span.bg);
+        if (asBg !== undefined) bg.add(asBg);
+      }
+    }
+    return { fg, bg };
+  }
