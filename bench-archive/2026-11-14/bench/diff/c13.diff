-  const detected = await detectProviders({ fetch, env: envWithSavedApiKeys() });
-  return detected.map((p) => ({ name: p.name, models: p.models }));
+  const catalog = await loadOrRefreshProviderCatalog({ fetch, env: envWithSavedApiKeys() });
