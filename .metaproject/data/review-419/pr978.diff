+    expect(sent).toHaveLength(1);
+    for (let i = 0; i < 20; i += 1) progress.tool("b");
+    expect(sent).toHaveLength(1);
+    c.advance(59_000);
+    expect(sent).toHaveLength(1);
+    c.advance(1_000);
+    expect(sent).toHaveLength(2);
