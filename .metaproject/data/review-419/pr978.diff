new file mode 100644
index 00000000..7d383540
--- /dev/null
+++ b/src/tui/approval-mirror.test.ts
@@ -0,0 +1,157 @@
+// AC2 (flow 419): an approval raised in the shell is answered once, from whichever place answers first,
+// and the other place is taken down. Both orders, plus silence in the topic and a stopped turn.
+
+import { describe, expect, test } from "bun:test";
+import type { RemoteApprovalAnswer } from "../remote/shell-bridge";
+import { type DockRace, isTopicPress, raceApproval } from "./approval-mirror";
+
+const press = (decision: "allow" | "deny", fromId = 7): RemoteApprovalAnswer => ({ decision, always: false, fromId });
+const silence: RemoteApprovalAnswer = { decision: "deny", always: false };
+
+function abortedWith(signal: AbortSignal): Promise<unknown> {
+  return new Promise((resolve) => {
+    if (signal.aborted) return resolve(signal.reason);
+    signal.addEventListener("abort", () => resolve(signal.reason), { once: true });
+  });
+}
+
+describe("isTopicPress", () => {
+  test("an allow, or a deny from a named user, is a press; a timeout deny is not", () => {
+    expect(isTopicPress(press("allow"))).toBe(true);
+    expect(isTopicPress(press("deny"))).toBe(true);
+    expect(isTopicPress(silence)).toBe(false);
+  });
+});
+
+describe("raceApproval", () => {
+  test("the dock answers first: the topic leg is aborted with the reason shell", async () => {
+    let topicSignal: AbortSignal | undefined;
+    const outcome = await raceApproval({
+      turnSignal: new AbortController().signal,
+      dock: async (race: DockRace) => {
+        race.opened();
+        return "allowed-in-dock";
+      },
+      topic: (signal) => {
+        topicSignal = signal;
+        return new Promise<RemoteApprovalAnswer>(() => undefined);
+      },
+    });
+    expect(outcome).toEqual({ from: "dock", result: "allowed-in-dock" });
+    expect(topicSignal?.aborted).toBe(true);
+    expect(topicSignal?.reason).toBe("shell");
+  });
+
+  test("a press in the topic ends the dock and wins", async () => {
+    const answer = press("allow");
+    let dockReason: unknown;
+    const outcome = await raceApproval({
+      turnSignal: new AbortController().signal,
+      dock: async (race) => {
+        race.opened();
+        dockReason = await abortedWith(race.signal);
+        expect(race.topicWon()).toBe(true);
+        return "ignored";
+      },
+      topic: async () => answer,
+    });
+    expect(outcome).toEqual({ from: "topic", answer });
+    expect(dockReason).toBe("topic");
+  });
+
+  test("a denial pressed in the topic wins too", async () => {
+    const answer = press("deny");
+    const outcome = await raceApproval({
+      turnSignal: new AbortController().signal,
+      dock: async (race) => {
+        race.opened();
+        await abortedWith(race.signal);
+        return "ignored";
+      },
+      topic: async () => answer,
+    });
+    expect(outcome).toEqual({ from: "topic", answer });
+  });
+
+  test("silence in the topic never ends the dock", async () => {
+    let dockAbortedEarly = true;
+    const outcome = await raceApproval({
+      turnSignal: new AbortController().signal,
+      dock: async (race) => {
+        race.opened();
+        await new Promise((resolve) => setTimeout(resolve, 15));
+        dockAbortedEarly = race.signal.aborted;
+        return "dock";
+      },
+      topic: async () => silence,
+    });
+    expect(dockAbortedEarly).toBe(false);
+    expect(outcome).toEqual({ from: "dock", result: "dock" });
+  });
+
+  test("a topic that fails never ends the dock", async () => {
+    const outcome = await raceApproval({
+      turnSignal: new AbortController().signal,
+      dock: async (race) => {
+        race.opened();
+        await new Promise((resolve) => setTimeout(resolve, 5));
+        return "dock";
+      },
+      topic: async () => {
+        throw new Error("serve is gone");
+      },
+    });
+    expect(outcome).toEqual({ from: "dock", result: "dock" });
+  });
+
+  test("the turn stops: the dock closes and the topic leg is told it was cancelled", async () => {
+    const turn = new AbortController();
+    let topicSignal: AbortSignal | undefined;
+    const outcome = await raceApproval({
+      turnSignal: turn.signal,
+      dock: async (race) => {
+        race.opened();
+        queueMicrotask(() => turn.abort("cancelled"));
+        await abortedWith(race.signal);
+        return "stopped";
+      },
+      topic: (signal) => {
+        topicSignal = signal;
+        return new Promise<RemoteApprovalAnswer>(() => undefined);
+      },
+    });
+    expect(outcome).toEqual({ from: "dock", result: "stopped" });
+    expect(topicSignal?.reason).toBe("cancelled");
+  });
+
+  test("a dock that never opens never starts the topic leg", async () => {
+    let started = false;
+    const outcome = await raceApproval({
+      turnSignal: new AbortController().signal,
+      dock: async () => "auto-approved",
+      topic: () => {
+        started = true;
+        return new Promise<RemoteApprovalAnswer>(() => undefined);
+      },
+    });
+    expect(outcome).toEqual({ from: "dock", result: "auto-approved" });
+    expect(started).toBe(false);
+  });
+
+  test("opened() starts the topic leg once", async () => {
+    let starts = 0;
+    await raceApproval({
+      turnSignal: new AbortController().signal,
+      dock: async (race) => {
+        race.opened();
+        race.opened();
+        return "x";
+      },
+      topic: () => {
+        starts += 1;
+        return new Promise<RemoteApprovalAnswer>(() => undefined);
+      },
+    });
+    expect(starts).toBe(1);
+  });
+});
diff --git a/src/tui/approval-mirror.ts b/src/tui/approval-mirror.ts
new file mode 100644
index 00000000..f4e21d08
--- /dev/null
+++ b/src/tui/approval-mirror.ts
@@ -0,0 +1,67 @@
+// Where an approval of a turn typed in the shell is answered (flow 419, AC1 and AC2).
+//
+// The dock opens in the terminal; when remote control is on, the same question is posted to the topic at
+// the moment the dock opens (a call that is auto-approved never reaches the topic). The first answer wins and
+// the other place is taken down: a press in the topic aborts the dock, an answer in the dock aborts the topic
+// leg, which tells serve to remove the buttons. Silence in the topic (a timeout, no connection) never ends
+// the question; the dock stays. Kept apart from the TUI so the race can be tested without a renderer.
+
+import type { RemoteApprovalAnswer } from "../remote/shell-bridge";
+
+/** What the dock-opening code in the shell sees of the race. */
+export interface DockRace {
+  /** Aborted when the turn stops or the topic answered first: the dock closes. */
+  readonly signal: AbortSignal;
+  /** The dock just opened: the topic leg starts (once). */
+  opened(): void;
+  /** The topic answered first. The dock's own result is then to be thrown away. */
+  topicWon(): boolean;
+}
+
+export type ApprovalRaceOutcome<V> = { from: "dock"; result: V } | { from: "topic"; answer: RemoteApprovalAnswer };
+
+/** An explicit press in the topic: an allow, or a deny that names who pressed. A timeout or an abort is neither. */
+export function isTopicPress(answer: RemoteApprovalAnswer): boolean {
+  return answer.decision === "allow" || answer.fromId !== undefined;
+}
+
+export async function raceApproval<V>(options: {
+  /** Runs the dock; resolves with its verdict, or early when `race.signal` aborted it. */
+  dock: (race: DockRace) => Promise<V>;
+  /** Asks in the topic; the answer is judged by {@link isTopicPress}. `signal` aborts it, with the reason "shell" or "cancelled". */
+  topic: (signal: AbortSignal) => Promise<RemoteApprovalAnswer>;
+  /** The turn stopped: both places are closed, the topic one as cancelled. */
+  turnSignal: AbortSignal;
+}): Promise<ApprovalRaceOutcome<V>> {
+  const dockAbort = new AbortController();
+  const topicAbort = new AbortController();
+  let topicAnswer: RemoteApprovalAnswer | undefined;
+  let settled = false;
+  let started = false;
+  const race: DockRace = {
+    signal: AbortSignal.any([options.turnSignal, dockAbort.signal]),
+    opened: () => {
+      if (started || settled) return;
+      started = true;
+      void options
+        .topic(topicAbort.signal)
+        .then((answer) => {
+          if (settled || !isTopicPress(answer)) return;
+          topicAnswer = answer;
+          dockAbort.abort("topic");
+        })
+        .catch(() => undefined);
+    },
+    topicWon: () => topicAnswer !== undefined,
+  };
+  try {
+    const result = await options.dock(race);
+    if (topicAnswer !== undefined) return { from: "topic", answer: topicAnswer };
+    return { from: "dock", result };
+  } finally {
+    settled = true;
+    // answered in the dock: serve says "answered in the shell"; the turn stopped: "cancelled". A leg that
+    // already ended ignores the abort, so a press that won keeps its own final state.
+    if (topicAnswer === undefined) topicAbort.abort(options.turnSignal.aborted ? "cancelled" : "shell");
+  }
+}
