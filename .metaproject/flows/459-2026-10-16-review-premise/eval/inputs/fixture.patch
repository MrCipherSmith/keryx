+import React from "react";
+
+type Props = { playing: boolean; onToggle: () => void; onSeekBack: () => void; onSeekForward: () => void };
+
+/** Play / pause and 10s seek buttons. Order is fixed: back, play, forward. */
+export function MediaPlaybackControls({ playing, onToggle, onSeekBack, onSeekForward }: Props) {
+  return (
+    <div className="media-controls" dir="ltr" style={{ display: "flex", gap: 8 }}>
+      <button onClick={onSeekBack} aria-label="Back 10 seconds">⏪</button>
