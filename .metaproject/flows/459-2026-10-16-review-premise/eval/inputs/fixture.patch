Subject: [PATCH 2/3] feat(player): scrollable playback timeline

Pin the timeline to dir=ltr. scrollLeft and pixel offsets map to media time, which flows left to right,
and the sibling media controls already do the same. Exempted from the logical-properties lint for this island.
---
 src/player/PlaybackTimeline.tsx | 37 +++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)
 create mode 100644 src/player/PlaybackTimeline.tsx

diff --git a/src/player/PlaybackTimeline.tsx b/src/player/PlaybackTimeline.tsx
new file mode 100644
index 0000000..6c37f1b
--- /dev/null
+++ b/src/player/PlaybackTimeline.tsx
@@ -0,0 +1,37 @@
+import React, { useEffect, useRef } from "react";
+
+type Props = { durationMs: number; positionMs: number; onSeek: (ms: number) => void };
+
+const PX_PER_SECOND = 40;
+
+/** Scrollable playback timeline. Pixel offset from the scroller's left edge is media time. */
+export function PlaybackTimeline({ durationMs, positionMs, onSeek }: Props) {
+  const scroller = useRef<HTMLDivElement>(null);
+
+  // wheel scrolls the strip horizontally, mapped to a seek
+  const onWheel = (e: React.WheelEvent<HTMLDivElement>) => {
+    const rect = e.currentTarget.getBoundingClientRect();
+    const x = e.clientX - rect.left;
+    onSeek((x / PX_PER_SECOND) * 1000);
+  };
+
+  useEffect(() => {
+    const el = scroller.current;
+    if (!el) return;
+    el.scrollLeft = (positionMs / 1000) * PX_PER_SECOND - el.clientWidth / 2;
+  }, [positionMs]);
+
+  useEffect(() => {
+    const onResize = () => {
+      const el = scroller.current;
+      if (el) el.scrollLeft = (positionMs / 1000) * PX_PER_SECOND - el.clientWidth / 2;
+    };
+    window.addEventListener("resize", onResize);
+  }, [positionMs]);
+
+  return (
+    <div className="timeline" dir="ltr" ref={scroller} onWheel={onWheel} style={{ overflowX: "auto" }}>
+      <div style={{ width: (durationMs / 1000) * PX_PER_SECOND, height: 48 }} />
+    </div>
+  );
+}
-- 
