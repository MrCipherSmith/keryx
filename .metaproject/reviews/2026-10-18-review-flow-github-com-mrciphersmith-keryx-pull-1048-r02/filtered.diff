+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { loadReferences, parseReferences, REFERENCES_PATH, REFERENCES_SCHEMA } from "./references-config";
+
+// AC1: `.metaproject/rules/project/references.json` (schema 1) is loaded; a
+// committed JSON schema validates it; a declaration with neither globs nor
+// keywords, an empty description or an absolute or escaping path is rejected with
+// a message naming the entry.
+
+const SCHEMA_FILE = path.join(import.meta.dir, "..", "..", "docs", "requirements", "keryx-conditional-reads", "schemas", "references.schema.json");
+
+const roots: string[] = [];
+afterEach(async () => {
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true });
+});
+
+async function project(references?: string): Promise<string> {
+  const root = await mkdtemp(path.join(tmpdir(), "keryx-references-config-"));
+  roots.push(root);
+  if (references !== undefined) {
+    await mkdir(path.dirname(path.join(root, REFERENCES_PATH)), { recursive: true });
+    await writeFile(path.join(root, REFERENCES_PATH), references, "utf8");
+  }
+  return root;
+}
+
+const GOOD_ENTRY = {
+  path: "STYLING.md",
+  when: { globs: ["src/**/*.css"], keywords: ["className", "tailwind"] },
+  anchor: "Class conventions",
+  description: "Class naming and the Tailwind 4 cascade contract.",
+};
+
+const doc = (...references: unknown[]): unknown => ({ schema: 1, references });
+
+describe("parseReferences", () => {
+  test("accepts a complete declaration and returns it typed", () => {
+    const result = parseReferences(doc(GOOD_ENTRY));
+    expect(result).toEqual({
+      ok: true,
+      references: [
+        {
+          path: "STYLING.md",
+          when: { globs: ["src/**/*.css"], keywords: ["className", "tailwind"] },
+          anchor: "Class conventions",
+          description: "Class naming and the Tailwind 4 cascade contract.",
+        },
+      ],
+    });
+  });
+
+  test("anchor is optional, and globs-only or keywords-only conditions are valid", () => {
+    const result = parseReferences(
+      doc(
+        { path: "A.md", when: { globs: ["src/**"] }, description: "Only globs." },
+        { path: "B.md", when: { keywords: ["theme"] }, description: "Only keywords." },
+      ),
+    );
+    expect(result.ok).toBe(true);
+    if (!result.ok) return;
+    expect(result.references[0]).toEqual({ path: "A.md", when: { globs: ["src/**"], keywords: [] }, description: "Only globs." });
+    expect(result.references[1]?.when).toEqual({ globs: [], keywords: ["theme"] });
+    expect(result.references[0]?.anchor).toBeUndefined();
+  });
+
+  test("normalises a path to posix and trims strings", () => {
+    const result = parseReferences(doc({ ...GOOD_ENTRY, path: "docs\\.\\STYLING.md", description: "  Padded description.  " }));
+    expect(result.ok).toBe(true);
+    if (result.ok) {
+      expect(result.references[0]?.path).toBe("docs/STYLING.md");
+      expect(result.references[0]?.description).toBe("Padded description.");
+    }
+  });
+
+  test("rejects a declaration with neither globs nor keywords, naming the entry", () => {
+    for (const when of [{}, { globs: [], keywords: [] }, undefined]) {
+      const result = parseReferences(doc({ ...GOOD_ENTRY, when }));
+      expect(result.ok).toBe(false);
+      if (result.ok) continue;
+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]).toContain('references[0] ("STYLING.md")');
+      expect(result.errors[0]).toMatch(/globs|keywords/);
+    }
+  });
+
+  test("rejects an empty or blank description", () => {
+    for (const description of ["", "   ", undefined, 7]) {
+      const result = parseReferences(doc({ ...GOOD_ENTRY, description }));
+      expect(result.ok).toBe(false);
+      if (!result.ok) expect(result.errors[0]).toContain('references[0] ("STYLING.md"): description');
+    }
+  });
+
+  test("rejects absolute paths", () => {
+    for (const bad of ["/etc/passwd", "\\windows\\x.md", "C:/x.md", "c:\\x.md"]) {
+      const result = parseReferences(doc({ ...GOOD_ENTRY, path: bad }));
+      expect(result.ok).toBe(false);
+      if (!result.ok) {
+        expect(result.errors[0]).toContain(`("${bad}")`);
+        expect(result.errors[0]).toContain("absolute");
+      }
+    }
+  });
+
+  test("rejects paths that escape the project root", () => {
+    for (const bad of ["../x.md", "docs/../../x.md", "..", "a/b/../../../c.md"]) {
+      const result = parseReferences(doc({ ...GOOD_ENTRY, path: bad }));
+      expect(result.ok).toBe(false);
+      if (!result.ok) {
+        expect(result.errors[0]).toContain(`("${bad}")`);
+        expect(result.errors[0]).toContain("escapes");
+      }
+    }
+  });
+
+  test("allows .. that stays inside the root", () => {
+    const result = parseReferences(doc({ ...GOOD_ENTRY, path: "docs/../STYLING.md" }));
+    expect(result.ok).toBe(true);
+    if (result.ok) expect(result.references[0]?.path).toBe("STYLING.md");
+  });
+
+  test("rejects an empty path and names the entry by index", () => {
+    const result = parseReferences(doc(GOOD_ENTRY, { ...GOOD_ENTRY, path: "" }));
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.errors[0]).toContain("references[1]");
+  });
+
+  test("reports every bad entry, not only the first", () => {
+    const result = parseReferences(doc({ ...GOOD_ENTRY, path: "../a.md" }, GOOD_ENTRY, { ...GOOD_ENTRY, description: "" }));
+    expect(result.ok).toBe(false);
+    if (!result.ok) {
+      expect(result.errors).toHaveLength(2);
+      expect(result.errors[0]).toContain("references[0]");
+      expect(result.errors[1]).toContain("references[2]");
+    }
+  });
+
+  test("rejects unknown properties, a wrong schema number and malformed shapes", () => {
+    expect(parseReferences({ schema: 2, references: [] }).ok).toBe(false);
+    expect(parseReferences({ references: [] }).ok).toBe(false);
+    expect(parseReferences({ schema: 1 }).ok).toBe(false);
+    expect(parseReferences({ schema: 1, references: [], extra: 1 }).ok).toBe(false);
+    expect(parseReferences(doc({ ...GOOD_ENTRY, extra: true })).ok).toBe(false);
+    expect(parseReferences(doc({ ...GOOD_ENTRY, anchor: "" })).ok).toBe(false);
+    expect(parseReferences(doc({ ...GOOD_ENTRY, when: { globs: "src/**" } })).ok).toBe(false);
+    expect(parseReferences(doc({ ...GOOD_ENTRY, when: { globs: [""], keywords: ["x"] } })).ok).toBe(false);
+    expect(parseReferences(doc({ ...GOOD_ENTRY, when: { globs: ["a"], extra: 1 } })).ok).toBe(false);
+    expect(parseReferences(doc("not an object")).ok).toBe(false);
+    expect(parseReferences([]).ok).toBe(false);
+    expect(parseReferences(null).ok).toBe(false);
+  });
+
+  test("an empty list is valid", () => {
+    expect(parseReferences({ schema: 1, references: [] })).toEqual({ ok: true, references: [] });
+  });
+
+  test("two declarations of one document are an error naming both entries and the path, even with different anchors or spellings", () => {
+    const result = parseReferences(
+      doc(
+        { ...GOOD_ENTRY, anchor: "Class conventions" },
+        { path: "A.md", when: { globs: ["src/**"] }, description: "Another document." },
+        { ...GOOD_ENTRY, path: "./docs/../STYLING.md", anchor: "Tailwind cascade" },
+      ),
+    );
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.errors).toHaveLength(1);
+    expect(result.errors[0]).toContain('references[2] ("STYLING.md")');
+    expect(result.errors[0]).toContain("references[0]");
+    expect(result.errors[0]).toContain("declare each document once");
+  });
+
+  test("distinct documents may share a condition and an anchor", () => {
+    const result = parseReferences(doc({ ...GOOD_ENTRY, path: "A.md" }, { ...GOOD_ENTRY, path: "B.md" }));
+    expect(result.ok).toBe(true);
+  });
+});
+
+describe("loadReferences", () => {
+  test("a missing file means no declarations, without an error", async () => {
+    const root = await project();
+    expect(await loadReferences(root)).toEqual({ ok: true, present: false, references: [] });
+  });
+
+  test("loads a present file", async () => {
+    const root = await project(JSON.stringify(doc(GOOD_ENTRY)));
+    const result = await loadReferences(root);
+    expect(result.ok).toBe(true);
+    if (!result.ok) return;
+    expect(result.present).toBe(true);
+    expect(result.references).toHaveLength(1);
+    expect(result.references[0]?.path).toBe("STYLING.md");
+  });
+
+  test("a leading byte order mark (an editor on Windows adds one) does not make the file invalid", async () => {
+    const root = await project(`\uFEFF${JSON.stringify(doc(GOOD_ENTRY))}`);
+    const result = await loadReferences(root);
+    expect(result.ok).toBe(true);
+    if (result.ok) expect(result.references).toHaveLength(1);
+  });
+
+  test("invalid JSON is an error naming the file, not a throw", async () => {
+    const root = await project("{ not json");
+    const result = await loadReferences(root);
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.errors[0]).toContain(REFERENCES_PATH);
+  });
+
+  test("a schema violation is an error naming the file and the entry", async () => {
+    const root = await project(JSON.stringify(doc({ ...GOOD_ENTRY, description: "" })));
+    const result = await loadReferences(root);
+    expect(result.ok).toBe(false);
+    if (!result.ok) {
+      expect(result.errors[0]).toContain(REFERENCES_PATH);
+      expect(result.errors[0]).toContain('references[0] ("STYLING.md")');
+    }
+  });
+
+  test("a directory in place of the file is an error, not a throw", async () => {
+    const root = await project();
+    await mkdir(path.join(root, REFERENCES_PATH), { recursive: true });
+    const result = await loadReferences(root);
+    expect(result.ok).toBe(false);
+  });
+});
+
+// A minimal evaluator for the JSON Schema keywords references.schema.json uses,
+// so the committed schema and the loader are shown to give one verdict.
+type Node = Record<string, unknown>;
+
+function validates(schema: Node, value: unknown): boolean {
+  if ("const" in schema && schema["const"] !== value) return false;
+  if (Array.isArray(schema["enum"]) && !schema["enum"].includes(value)) return false;
+  if (Array.isArray(schema["anyOf"]) && !(schema["anyOf"] as Node[]).some((branch) => validates(branch, value))) return false;
+  const type = schema["type"] ?? (Array.isArray(schema["required"]) ? "object" : undefined);
+  if (type === "object") {
+    if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
+    const record = value as Node;
+    for (const key of (schema["required"] as string[] | undefined) ?? []) if (!(key in record)) return false;
+    const properties = (schema["properties"] as Record<string, Node> | undefined) ?? {};
+    for (const [key, child] of Object.entries(record)) {
+      const rule = properties[key];
+      if (rule === undefined) {
+        if (schema["additionalProperties"] === false) return false;
+      } else if (!validates(rule, child)) return false;
+    }
+  } else if (type === "array") {
+    if (!Array.isArray(value)) return false;
+    if (typeof schema["minItems"] === "number" && value.length < schema["minItems"]) return false;
+    if (schema["items"] !== undefined && !value.every((item) => validates(schema["items"] as Node, item))) return false;
+  } else if (type === "string") {
+    if (typeof value !== "string") return false;
+    if (typeof schema["minLength"] === "number" && value.length < schema["minLength"]) return false;
+    if (typeof schema["pattern"] === "string" && !new RegExp(schema["pattern"], "u").test(value)) return false;
+  } else if (type === "integer") {
+    if (!Number.isInteger(value)) return false;
+  }
+  return true;
+}
+
+describe("references.schema.json", () => {
+  test("the inline schema is the committed schema", async () => {
+    const committed: unknown = JSON.parse(await readFile(SCHEMA_FILE, "utf8"));
+    expect(committed).toEqual(REFERENCES_SCHEMA);
+  });
+
+  const cases: Array<[string, unknown, boolean]> = [
+    ["full entry", doc(GOOD_ENTRY), true],
+    ["empty list", { schema: 1, references: [] }, true],
+    ["globs only", doc({ path: "A.md", when: { globs: ["a/**"] }, description: "x" }), true],
+    ["keywords only", doc({ path: "A.md", when: { keywords: ["theme"] }, description: "x" }), true],
+    ["neither globs nor keywords", doc({ ...GOOD_ENTRY, when: {} }), false],
+    ["empty globs and keywords", doc({ ...GOOD_ENTRY, when: { globs: [], keywords: [] } }), false],
+    ["missing when", doc({ path: "A.md", description: "x" }), false],
+    ["empty description", doc({ ...GOOD_ENTRY, description: "" }), false],
+    ["blank description", doc({ ...GOOD_ENTRY, description: "  " }), false],
+    ["missing description", doc({ path: "A.md", when: { globs: ["a"] } }), false],
+    ["absolute path", doc({ ...GOOD_ENTRY, path: "/etc/x.md" }), false],
+    ["drive path", doc({ ...GOOD_ENTRY, path: "C:/x.md" }), false],
+    ["empty path", doc({ ...GOOD_ENTRY, path: "" }), false],
+    ["empty anchor", doc({ ...GOOD_ENTRY, anchor: "" }), false],
+    ["unknown entry key", doc({ ...GOOD_ENTRY, extra: 1 }), false],
+    ["unknown when key", doc({ ...GOOD_ENTRY, when: { globs: ["a"], extra: 1 } }), false],
+    ["unknown root key", { schema: 1, references: [], extra: 1 }, false],
+    ["wrong schema number", { schema: 2, references: [] }, false],
+    ["missing schema", { references: [] }, false],
+    ["missing references", { schema: 1 }, false],
+    ["empty glob string", doc({ ...GOOD_ENTRY, when: { globs: [""] } }), false],
+    ["globs not an array", doc({ ...GOOD_ENTRY, when: { globs: "a" } }), false],
+  ];
+
+  for (const [name, input, expected] of cases) {
+    test(`schema and loader agree: ${name}`, () => {
+      expect(validates(REFERENCES_SCHEMA as Node, input)).toBe(expected);
+      expect(parseReferences(input).ok).toBe(expected);
+    });
+  }
+
+  test("a path that escapes the root passes the schema and is rejected by the loader", () => {
+    // JSON Schema cannot express normalisation; the loader owns this check.
+    const input = doc({ ...GOOD_ENTRY, path: "../x.md" });
+    expect(validates(REFERENCES_SCHEMA as Node, input)).toBe(true);
+    expect(parseReferences(input).ok).toBe(false);
+  });
+});
diff --git a/src/gdskills/references-config.ts b/src/gdskills/references-config.ts
new file mode 100644
index 000000000..823c22cef
--- /dev/null
+++ b/src/gdskills/references-config.ts
@@ -0,0 +1,280 @@
+// Declarations of conditional references, read from
+// `.metaproject/rules/project/references.json` (schema 1):
+//
+//   { "schema": 1, "references": [
+//     { "path": "STYLING.md",
+//       "when": { "globs": ["src/**/*.css"], "keywords": ["className"] },
+//       "anchor": "Class conventions",
+//       "description": "What the document governs and when to read it." } ] }
+//
+// The resolver promotes a declared document to `must_read` when its condition
+// matches the task; the validator checks the proof of reading against it. The
+// committed JSON schema is docs/requirements/keryx-conditional-reads/schemas/
+// references.schema.json and REFERENCES_SCHEMA mirrors it (a test keeps them
+// equal). A missing file is "no declarations", not an error. Loading never
+// throws: problems come back as messages that name the file and the entry.
+
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+
+export const REFERENCES_PATH = ".metaproject/rules/project/references.json";
+export const REFERENCES_SCHEMA_VERSION = 1;
+
+/** Where a declared document applies. At least one of the two lists is non-empty. */
+export type ReferenceCondition = {
+  /** Globs matched against the task's files. */
+  globs: string[];
+  /** Words matched against the task text. */
+  keywords: string[];
+};
+
+export type ReferenceDeclaration = {
+  /** Project-relative posix path, normalised, never absolute and never escaping the root. */
+  path: string;
+  when: ReferenceCondition;
+  /** Heading text or slug of the section that matters; absent means the whole file. */
+  anchor?: string;
+  description: string;
+};
+
+export type ParseReferencesResult = { ok: true; references: ReferenceDeclaration[] } | { ok: false; errors: string[] };
+
+export type LoadReferencesResult =
+  | { ok: true; /** False when the file does not exist. */ present: boolean; references: ReferenceDeclaration[] }
+  | { ok: false; errors: string[] };
+
+export const REFERENCES_SCHEMA = {
+  $schema: "https://json-schema.org/draft/2020-12/schema",
+  $id: "https://keryx.dev/schemas/references.schema.json",
+  title: "Keryx conditional reference declarations",
+  description:
+    ".metaproject/rules/project/references.json. See README.md section 5.1. Each entry declares a document that project rules cite, where it applies (file globs and task keywords), the section that matters (anchor) and what it governs. A path must be relative and stay inside the project root; JSON Schema cannot express that normalisation, so the loader (src/gdskills/references-config.ts) also rejects a path that escapes the root. Each document is declared once: two entries whose normalised paths are equal make the file invalid, which JSON Schema cannot express either.",
+  type: "object",
+  additionalProperties: false,
+  required: ["schema", "references"],
+  properties: {
+    schema: { const: 1 },
+    references: {
+      type: "array",
+      items: {
+        type: "object",
+        additionalProperties: false,
+        required: ["path", "when", "description"],
+        properties: {
+          path: {
+            type: "string",
+            minLength: 1,
+            pattern: "^(?![/\\\\])(?![A-Za-z]:).+$",
+            description: "Project-relative path of the document; absolute paths and paths escaping the root are rejected.",
+          },
+          when: {
+            type: "object",
+            additionalProperties: false,
+            anyOf: [{ required: ["globs"] }, { required: ["keywords"] }],
+            properties: {
+              globs: {
+                type: "array",
+                minItems: 1,
+                items: { type: "string", minLength: 1, pattern: "\\S" },
+                description: "Globs matched against the task's files; a match promotes the reference.",
+              },
+              keywords: {
+                type: "array",
+                minItems: 1,
+                items: { type: "string", minLength: 1, pattern: "\\S" },
+                description: "Words matched case-insensitively, on a word boundary, against the task text.",
+              },
+            },
+          },
+          anchor: {
+            type: "string",
+            minLength: 1,
+            pattern: "\\S",
+            description: "Heading text or slug of the section that matters; without it the whole file is the obligation.",
+          },
+          description: {
+            type: "string",
+            minLength: 1,
+            pattern: "\\S",
+            description: "What the document governs and when to read it.",
+          },
+        },
+      },
+    },
+  },
+} as const;
+
+type Json = Record<string, unknown>;
+
+function isObject(value: unknown): value is Json {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function label(index: number, raw: Json): string {
+  return typeof raw["path"] === "string" ? `references[${index}] ("${raw["path"]}")` : `references[${index}]`;
+}
+
+/** A project-relative posix path, or the reason it is not one. */
+function normaliseRelativePath(raw: string): { path: string } | { problem: string } {
+  const posix = raw.trim().replace(/\\/g, "/");
+  if (posix === "") return { problem: "path is empty" };
+  if (posix.startsWith("/") || /^[A-Za-z]:/.test(posix)) return { problem: "path is absolute; use a path relative to the project root" };
+  const normal = path.posix.normalize(posix);
+  if (normal === ".." || normal.startsWith("../")) return { problem: "path escapes the project root" };
+  if (normal === ".") return { problem: "path names the project root, not a document" };
+  return { path: normal };
+}
+
+/** A path a rule cites, as the project spells it: posix, normalised, never absolute and never climbing out of the root. */
+export function normaliseCitedPath(cited: string): string | undefined {
+  const posix = cited.replace(/\\/g, "/");
+  if (posix.startsWith("/") || /^[A-Za-z]:/.test(posix)) return undefined;
+  const normal = path.posix.normalize(posix);
+  return normal === ".." || normal.startsWith("../") ? undefined : normal;
+}
+
+/** A cited path that names a document someone must be told to read: a `.md` outside the rules folder (a `.mdc` or a file under the rules folder is another rule). */
+export function isDocumentCitation(relative: string): boolean {
+  return relative.endsWith(".md") && !relative.startsWith(".metaproject/rules/");
+}
+
+function stringList(value: unknown, field: string, who: string, errors: string[]): string[] | undefined {
+  if (value === undefined) return undefined;
+  if (!Array.isArray(value)) {
+    errors.push(`${who}: when.${field} must be an array of non-empty strings`);
+    return undefined;
+  }
+  const items: string[] = [];
+  for (const item of value) {
+    if (typeof item !== "string" || item.trim() === "") {
+      errors.push(`${who}: when.${field} must hold only non-empty strings`);
+      return undefined;
+    }
+    items.push(item.trim());
+  }
+  return items;
+}
+
+function parseWhen(value: unknown, who: string, errors: string[]): ReferenceCondition | undefined {
+  if (!isObject(value)) {
+    errors.push(`${who}: when must be an object with globs and/or keywords; a declaration with neither can never match`);
+    return undefined;
+  }
+  const before = errors.length;
+  for (const key of Object.keys(value)) {
+    if (key !== "globs" && key !== "keywords") errors.push(`${who}: when has an unknown property "${key}"`);
+  }
+  const globs = stringList(value["globs"], "globs", who, errors);
+  const keywords = stringList(value["keywords"], "keywords", who, errors);
+  if (errors.length > before) return undefined;
+  if ((globs ?? []).length === 0 && (keywords ?? []).length === 0) {
+    errors.push(`${who}: when needs at least one of globs or keywords; a declaration with neither can never match`);
+    return undefined;
+  }
+  for (const [field, list] of [["globs", globs], ["keywords", keywords]] as const) {
+    if (list?.length === 0) errors.push(`${who}: when.${field} must not be empty; omit it instead`);
+  }
+  return errors.length > before ? undefined : { globs: globs ?? [], keywords: keywords ?? [] };
+}
+
+const ENTRY_KEYS = new Set(["path", "when", "anchor", "description"]);
+
+function parseEntry(raw: unknown, index: number, errors: string[]): ReferenceDeclaration | undefined {
+  if (!isObject(raw)) {
+    errors.push(`references[${index}]: must be an object`);
+    return undefined;
+  }
+  const who = label(index, raw);
+  const before = errors.length;
+  for (const key of Object.keys(raw)) {
+    if (!ENTRY_KEYS.has(key)) errors.push(`${who}: unknown property "${key}"`);
+  }
+
+  let normalised: string | undefined;
+  if (typeof raw["path"] !== "string") {
+    errors.push(`${who}: path must be a string`);
+  } else {
+    const result = normaliseRelativePath(raw["path"]);
+    if ("problem" in result) errors.push(`${who}: ${result.problem}`);
+    else normalised = result.path;
+  }
+
+  const when = parseWhen(raw["when"], who, errors);
+
+  let anchor: string | undefined;
+  if (raw["anchor"] !== undefined) {
+    if (typeof raw["anchor"] !== "string" || raw["anchor"].trim() === "") errors.push(`${who}: anchor must be a non-empty string when present`);
+    else anchor = raw["anchor"].trim();
+  }
+
+  let description = "";
+  if (typeof raw["description"] !== "string" || raw["description"].trim() === "") {
+    errors.push(`${who}: description must be a non-empty string saying what the document governs`);
+  } else {
+    description = raw["description"].trim();
+  }
+
+  if (errors.length > before || normalised === undefined || when === undefined) return undefined;
+  return { path: normalised, when, ...(anchor !== undefined ? { anchor } : {}), description };
+}
+
+/** Validate an already-parsed `references.json`. Every bad entry is reported, not only the first. */
+export function parseReferences(input: unknown): ParseReferencesResult {
+  if (!isObject(input)) return { ok: false, errors: ["references file must be a JSON object"] };
+  const errors: string[] = [];
+  for (const key of Object.keys(input)) {
+    if (key !== "schema" && key !== "references") errors.push(`unknown property "${key}"`);
+  }
+  if (input["schema"] !== REFERENCES_SCHEMA_VERSION) {
+    errors.push(`schema must be ${REFERENCES_SCHEMA_VERSION}; got ${JSON.stringify(input["schema"])}`);
+  }
+  const entries = input["references"];
+  if (!Array.isArray(entries)) {
+    errors.push("references must be an array");
+    return { ok: false, errors };
+  }
+  const references: ReferenceDeclaration[] = [];
+  const firstIndexOf = new Map<string, number>();
+  entries.forEach((raw: unknown, index) => {
+    const entry = parseEntry(raw, index, errors);
+    if (entry === undefined) return;
+    const first = firstIndexOf.get(entry.path);
+    if (first !== undefined) {
+      errors.push(`references[${index}] ("${entry.path}"): the same document is already declared by references[${first}]; declare each document once, with one anchor`);
+      return;
+    }
+    firstIndexOf.set(entry.path, index);
+    references.push(entry);
+  });
+  return errors.length > 0 ? { ok: false, errors } : { ok: true, references };
+}
+
+function isMissingFile(error: unknown): boolean {
+  return typeof error === "object" && error !== null && (error as { code?: unknown }).code === "ENOENT";
+}
+
+/**
+ * Read and validate the project's declarations. A missing file is an empty list;
+ * unreadable or invalid content is `ok: false` with messages that name the file
+ * (and the entry, for a schema violation).
+ */
+export async function loadReferences(projectRoot: string): Promise<LoadReferencesResult> {
+  let text: string;
+  try {
+    text = await readFile(path.join(projectRoot, REFERENCES_PATH), "utf8");
+  } catch (error) {
+    if (isMissingFile(error)) return { ok: true, present: false, references: [] };
+    const reason = error instanceof Error ? error.message : String(error);
+    return { ok: false, errors: [`${REFERENCES_PATH}: cannot be read (${reason})`] };
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text.charCodeAt(0) === 0xfeff ? text.slice(1) : text);
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error);
+    return { ok: false, errors: [`${REFERENCES_PATH}: is not valid JSON (${reason})`] };
+  }
+  const result = parseReferences(parsed);
+  if (!result.ok) return { ok: false, errors: result.errors.map((message) => `${REFERENCES_PATH}: ${message}`) };
+  return { ok: true, present: true, references: result.references };
+}
