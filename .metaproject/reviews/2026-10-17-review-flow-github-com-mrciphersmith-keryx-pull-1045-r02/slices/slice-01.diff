     .filter((run): run is { reviewer: string; model?: string; rawEvidence?: unknown } => run !== null && typeof run === "object" && typeof (run as { reviewer?: unknown }).reviewer === "string" && (run as { rawEvidence?: unknown }).rawEvidence !== undefined)
