   const relative = lexicalRelativePath(cited);
   if (relative === null) {
     return false;
   }
   if (head !== null && (await readFileAtCommit(cwd, head, relative)) !== null) {
     return true;
   }
   return lstat(path.resolve(cwd, relative)).then(
