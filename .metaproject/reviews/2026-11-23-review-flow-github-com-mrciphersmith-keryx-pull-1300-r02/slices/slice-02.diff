+const unsaved = (s: SessionInfo) => (s.updatedAt ? Date.parse(s.updatedAt) || 0 : Number.POSITIVE_INFINITY);
+const newestBoundFirst = (a: SessionInfo, b: SessionInfo) => unsaved(b) - unsaved(a);
+
+/**
