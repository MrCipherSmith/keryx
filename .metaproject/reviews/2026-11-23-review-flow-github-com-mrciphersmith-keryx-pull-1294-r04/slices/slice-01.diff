+  const note = reviewNote(c);
+  if (note) return note;
   if (c.decision) return DECISION_LABEL[c.decision];
   if (c.draft) return "Draft pull request";
   return c.reviewersComplete === false ? "Review requests incomplete" : "No review requested";
 }

