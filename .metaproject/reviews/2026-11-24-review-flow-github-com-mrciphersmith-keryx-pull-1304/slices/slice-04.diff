+      for (const [, n] of text.matchAll(/p(\d+):pullRequest/g)) {
+        const pr = heads[Number(n)];
+        repository[`p${n}`] = pr ? prCard(Number(n), pr.head, pr.state) : null;
+      }
+      return { viewer: { login: viewer }, repository } as T;
+    }
