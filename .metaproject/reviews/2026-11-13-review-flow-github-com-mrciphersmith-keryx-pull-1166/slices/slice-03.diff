+  const run = runWithCallWatchdog(
+    "spawn_subagent",
+    async (_signal, stage: CallStage) => {
+      stage.current = "approval";
+      return hang();
+    },
+    { signal: turn.signal, capMs: 20, abortGraceMs: 20 },
+  );
