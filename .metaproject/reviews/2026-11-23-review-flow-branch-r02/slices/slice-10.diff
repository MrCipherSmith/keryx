+}
+.metaproject-details-actions { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-block-start: var(--sp-1); }
+
+/* ---- relationship list ---- */
+.metaproject-rel { display: grid; gap: var(--sp-4); min-inline-size: 0; }
+.metaproject-rel-note { margin: 0; font-size: var(--fs-sm); color: var(--fg-muted); }
+.metaproject-rel-group, .metaproject-rel-kind-group { display: grid; gap: var(--sp-1); min-inline-size: 0; }
+.metaproject-rel-group { gap: var(--sp-2); }
+.metaproject-rel-heading, .metaproject-rel-kind {
+  display: flex;
+  align-items: baseline;
+  gap: var(--sp-1);
+  margin: 0;
+  font-size: var(--fs-sm);
+  color: var(--fg-muted);
+}
+.metaproject-rel-heading { font-weight: 650; color: var(--fg); }
+.metaproject-rel-kind { font-weight: 500; padding-inline-start: var(--sp-2); }
+.metaproject-rel-list { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
+/* A row stays on one line: the title and path shorten with an ellipsis; opened evidence wraps below. */
+.metaproject-rel-item { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--sp-1); min-inline-size: 0; }
+.metaproject-rel-row { flex: 1 1 0; min-inline-size: 0; min-block-size: 28px; gap: var(--sp-2); }
+.metaproject-rel-row:focus-visible { outline-offset: -2px; }
+.metaproject-rel-title { font-size: var(--fs-md); color: var(--fg); }
+.metaproject-rel-row .metaproject-rel-title { flex: 0 1 auto; max-inline-size: 60%; }
+.metaproject-rel-path {
+  flex: 1 1 0;
+  min-inline-size: 4ch;
+  font-family: var(--mono);
+  font-size: var(--fs-sm);
+  color: var(--fg-muted);
+}
+.metaproject-rel-origin { flex: none; }
+.metaproject-rel-count { flex: none; font-size: var(--fs-sm); color: var(--fg-muted); white-space: nowrap; }
+.metaproject-rel-toggle { flex: none; gap: 2px; color: var(--fg-muted); }
+.metaproject-rel-evidence {
+  flex: 1 0 100%;
+  display: grid;
+  gap: 2px;
+  margin: 0;
+  padding: 0 var(--sp-2) var(--sp-1);
+  list-style: none;
+  font-size: var(--fs-sm);
+  color: var(--fg-muted);
+  overflow-wrap: anywhere;
+}
+.metaproject-rel-disclosure > summary {
+  display: flex;
+  align-items: center;
+  min-block-size: 24px;
+  cursor: default;
+  list-style-position: inside;
+}
+.metaproject-rel-disclosure > summary .metaproject-rel-heading { display: inline-flex; }
+.metaproject-rel-disclosure[open] > summary { margin-block-end: var(--sp-2); }
+.metaproject-rel-second {
+  display: grid;
+  gap: var(--sp-1);
+  padding: var(--sp-2);
+  border-radius: var(--r-md);
+  background: var(--bg-sunken);
+}
+.metaproject-rel-ends-label { margin: 0; overflow-wrap: anywhere; }
+.metaproject-rel-ends-label .metaproject-rel-origin { margin-inline-start: var(--sp-1); }
+.metaproject-rel-edge-kind { font-size: var(--fs-sm); color: var(--fg-muted); }
+.metaproject-rel-ends { display: flex; flex-wrap: wrap; gap: var(--sp-1); }
+.metaproject-rel-ends .btn {
+  max-inline-size: 100%;
+  block-size: auto;
+  min-block-size: 24px;
+  padding-block: 2px;
+  white-space: normal;
+  text-align: start;
+  overflow-wrap: anywhere;
+}

