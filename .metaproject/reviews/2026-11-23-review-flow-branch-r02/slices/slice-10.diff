+.metaproject-details-loading { margin: 0; padding: var(--sp-2) 0; font-size: var(--fs-sm); }
+
+.metaproject-details-doc { display: grid; gap: var(--sp-1); }
+.metaproject-details-doc + .metaproject-details-doc { padding-block-start: var(--sp-3); border-block-start: 1px solid var(--border); }
+.metaproject-details-doc h3 { margin: 0; font-size: var(--fs-md); font-weight: 600; overflow-wrap: anywhere; }
+.metaproject-details-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--sp-2);
+  margin: 0;
+  font-size: var(--fs-sm);
+  color: var(--fg-muted);
+  overflow-wrap: anywhere;
+}
+.metaproject-details-preview {
+  display: -webkit-box;
