+.metaproject-details-facts .info-val { text-align: start; overflow-wrap: anywhere; }
+
+.metaproject-details-tabs { padding-inline: var(--sp-2); }
+.metaproject-details-tabs .tab:focus-visible { outline-offset: -2px; }
+
+.metaproject-details-body {
+  flex: 1;
+  min-block-size: 0;
+  overflow: auto;
+  overflow-wrap: anywhere;
+  padding: var(--sp-3);
+  display: grid;
+  align-content: start;
+  gap: var(--sp-3);
