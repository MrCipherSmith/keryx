+/* Node details panel and relationship list of the Metaproject explorer. Tokens only.
+   Type: --fs-lg title, --fs-md body and rows, --fs-sm meta and section headings. */
+
+/* ---- panel ---- */
+.metaproject-details {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  min-block-size: 0;
+  min-inline-size: 0;
+  background: var(--bg-surface);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--r-md);
+}
+/* Below an 820 px host: a right-anchored drawer that leaves part of the content visible. */
+.metaproject-details.compact {
+  position: absolute;
+  inset-block: var(--sp-2);
+  inset-inline-end: var(--sp-2);
+  inline-size: min(380px, calc(100% - var(--sp-7) - var(--sp-5)));
+  z-index: 4;
+  box-shadow: var(--shadow-sheet);
+  animation: slide-in var(--dur) var(--ease-out);
+}
+.metaproject-details-resize::before {
+  content: "";
+  position: absolute;
+  inset: 0 2px;
+  background: var(--border);
+}
+.metaproject-details-resize:focus-visible { background: var(--accent-soft); outline-offset: 2px; }
+
+.metaproject-details-head {
+  display: grid;
+  gap: var(--sp-1);
+  padding: var(--sp-2) var(--sp-2) var(--sp-3) var(--sp-3);
+  flex: none;
+}
+.metaproject-details-toprow { display: flex; align-items: center; gap: var(--sp-2); }
+.metaproject-kind-badge { gap: var(--sp-1); }
+.metaproject-details-head h2 {
+  margin: 0;
+  font-size: var(--fs-lg);
+  font-weight: 650;
+  line-height: 1.3;
+  color: var(--fg);
+  overflow-wrap: anywhere;
+}
+.metaproject-details-path { display: flex; align-items: flex-start; gap: var(--sp-1); min-inline-size: 0; }
+.metaproject-details-path code {
+  flex: 1;
+  min-inline-size: 0;
+  padding-block-start: 6px;
+  font-family: var(--mono);
+  font-size: var(--fs-sm);
+  color: var(--fg-muted);
+  overflow-wrap: anywhere;
+}
+.metaproject-details-copied { align-self: center; font-size: var(--fs-sm); color: var(--fg-muted); }
+.metaproject-details-copied:empty { display: none; }
+
+.metaproject-details-facts {
+  flex: none;
+  padding: var(--sp-2) var(--sp-3) var(--sp-3);
+  border-block-start: 1px solid var(--border);
+}
+/* Wide enough for the longest key, "Relationships"; ch follows the text scale. */
+.metaproject-details-facts .info-key { inline-size: 14ch; font-size: var(--fs-sm); }
+.metaproject-details-module {
+  display: inline-flex;
+  align-items: center;
