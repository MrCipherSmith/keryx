+  expect(item("client.ts")).not.toBeNull();
+  expect(tree.calls.filter(call => call.parent === "src")).toHaveLength(3);
+  expect(waits).toHaveLength(2);
+  expect(waits.every(ms => ms > 0)).toBe(true);
+});
