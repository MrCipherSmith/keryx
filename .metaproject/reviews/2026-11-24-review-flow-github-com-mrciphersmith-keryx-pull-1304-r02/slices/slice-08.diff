+export const EMPTY_REVIEW_FILTERS: ReviewFilters = { state: "", freshness: "", source: "" };
+
+export function filtersActive(filters: ReviewFilters): boolean {
+  return !!(filters.state || filters.freshness || filters.source);
+}
