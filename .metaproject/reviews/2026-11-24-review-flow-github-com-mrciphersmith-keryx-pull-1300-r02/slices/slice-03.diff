+const variants: [string, Lock][] = [
+  ["withFileLock", async (lockPath, fn, options) => withFileLock(lockPath, fn, options)],
+  ["withFileLockAsync", (lockPath, fn, options) => withFileLockAsync(lockPath, fn, options)],
