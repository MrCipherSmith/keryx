+  const counts: PremiseCounts = {
+    ...(judge === undefined ? {} : { judge }),
+    claims: claims.length,
+    applied: appliedClaims,
+    rejected: rejections.length,
+    upheld: 0,
+    downgraded: 0,
+    challenged: 0,
+    ownerDecision: 0,
+    held: 0,
+    findingsIn: findings.length,
