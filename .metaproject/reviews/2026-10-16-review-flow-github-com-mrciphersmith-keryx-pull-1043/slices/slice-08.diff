+  for (const claim of claims) {
+    const name = claimName(claim);
+    const reject = (reason: PremiseRejectionReason, detail: string): void => {
+      rejections.push({ finding: name, reason, detail });
+    };
+    if (judge === undefined || actorKey(judge) === "") {
