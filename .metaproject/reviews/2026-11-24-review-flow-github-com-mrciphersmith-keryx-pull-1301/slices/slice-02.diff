     case "folder": return `folder:${entry.path}:${entry.files}${entry.module ? `:${entry.module.id}` : ""}`;
     case "group": return `group:${entry.key}:${entry.name}:${entry.pages}`;
     case "node": return `node:${entry.node.id}`;
   }

