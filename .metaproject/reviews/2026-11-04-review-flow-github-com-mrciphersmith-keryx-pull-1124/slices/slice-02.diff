+
+/* Same layer as the rules they extend, so Tailwind utilities (layer utilities)
+   can still override the rail and Select padding. */
+@layer components {
+.nav-item.desktop-rail-toggle { display:none; }
+@media (min-width:1024px) {
+  .nav-item.desktop-rail-toggle { display:flex; }
+  .rail-collapsed .sidebar { width:60px; padding-inline:7px; }
+  .rail-collapsed .sidebar :is(.sidebar-brand,.sidebar-projects > span,.identity > p,.nav-label,.sidebar-projects .truncate) { display:none; }
+  .rail-collapsed .identity { padding-inline:0; }
+  .rail-collapsed .identity .hub-button { width:100%; justify-content:center; min-height:44px; margin-top:0; }
+  .rail-collapsed .nav-item { justify-content:center; min-height:44px; padding-inline:0; }
+}
+.hub-select:not([multiple]):not([size]) {
+  appearance:none;
+  padding-inline-end:2.5rem;
+  /* Longhands only: the rule must not reset background-color, or it
+     overrides the .hub-input:disabled fill. The chevron colour is baked per
+     theme in --hub-select-chevron (a background image cannot read tokens). */
+  background-image: var(--hub-select-chevron);
+  background-repeat: no-repeat;
+  background-position: right .75rem center;
+  background-size: 1rem;
+}
+@media (forced-colors:active) {
+  .hub-select:not([multiple]):not([size]) { appearance:auto; background-image:none; }
+}
+}

