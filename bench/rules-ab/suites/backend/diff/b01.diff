+++ b/services/orders-api/src/refunds/refund.entity.ts
@@ -0,0 +1,20 @@
+import { Column, CreateDateColumn, Entity, Index, PrimaryGeneratedColumn } from "typeorm";
+
+@Entity("refunds")
+@Index("idx_refunds_order_id", ["orderId"])
+export class Refund {
+  @PrimaryGeneratedColumn("uuid")
+  id!: string;
+
+  @Column({ name: "order_id", type: "uuid" })
+  orderId!: string;
+
+  @Column({ name: "amount_cents", type: "integer" })
+  amountCents!: number;
+
+  @Column({ type: "varchar", length: 200 })
+  reason!: string;
+
+  @CreateDateColumn({ name: "created_at", type: "timestamptz" })
+  createdAt!: Date;
+}
diff --git a/services/orders-api/src/refunds/refunds.controller.ts b/services/orders-api/src/refunds/refunds.controller.ts
new file mode 100644
index 000000000..76b66fe74
--- /dev/null
+++ b/services/orders-api/src/refunds/refunds.controller.ts
@@ -0,0 +1,28 @@
+import { Body, Controller, Get, Param, ParseUUIDPipe, Post, Res } from "@nestjs/common";
+import type { Response } from "express";
+import { RefundsService, RefundView } from "./refunds.service";
+
+@Controller("v1/orders/:id/refunds")
+export class RefundsController {
+  constructor(private readonly refunds: RefundsService) {}
+
+  @Get()
+  list(@Param("id", ParseUUIDPipe) id: string): Promise<RefundView[]> {
+    return this.refunds.listForOrder(id);
+  }
+
+  @Post()
+  async create(
+    @Param("id", ParseUUIDPipe) id: string,
+    @Body() body: { amountCents: number; reason: string },
+    @Res() res: Response,
+  ): Promise<void> {
+    try {
+      const refund = await this.refunds.create(id, body.amountCents, body.reason);
+      res.status(201).json(refund);
+    } catch (e) {
+      const err = e as { status?: number; message: string };
+      res.status(err.status ?? 500).json({ error: err.message });
+    }
+  }
+}
diff --git a/services/orders-api/src/refunds/refunds.service.ts b/services/orders-api/src/refunds/refunds.service.ts
new file mode 100644
index 000000000..8a882f4b8
--- /dev/null
+++ b/services/orders-api/src/refunds/refunds.service.ts
@@ -0,0 +1,45 @@
+import { Injectable, NotFoundException, UnprocessableEntityException } from "@nestjs/common";
+import { InjectDataSource } from "@nestjs/typeorm";
+import { DataSource } from "typeorm";
+import { Order } from "../orders/order.entity";
+import { Refund } from "./refund.entity";
+
+export interface RefundView {
+  id: string;
+  amountCents: number;
+  reason: string;
+  createdAt: string;
+}
+
+@Injectable()
+export class RefundsService {
+  constructor(@InjectDataSource() private readonly dataSource: DataSource) {}
+
+  async create(orderId: string, amountCents: number, reason: string): Promise<RefundView> {
+    if (!Number.isInteger(amountCents) || amountCents <= 0) {
+      throw new UnprocessableEntityException("amountCents must be a positive integer");
+    }
+    if (!reason || reason.length > 200) {
+      throw new UnprocessableEntityException("reason is required, at most 200 characters");
+    }
+    return this.dataSource.transaction(async (manager) => {
+      const order = await manager.findOne(Order, { where: { id: orderId }, lock: { mode: "pessimistic_write" } });
+      if (!order) throw new NotFoundException("Order not found");
+      const refunded = await manager.sum(Refund, "amountCents", { orderId });
+      if ((refunded ?? 0) + amountCents > order.totalCents) {
+        throw new UnprocessableEntityException("Refund exceeds the order total");
+      }
+      const refund = await manager.save(manager.create(Refund, { orderId, amountCents, reason }));
+      return toView(refund);
+    });
+  }
+
+  async listForOrder(orderId: string): Promise<RefundView[]> {
+    const rows = await this.dataSource.getRepository(Refund).find({ where: { orderId }, order: { createdAt: "ASC" } });
+    return rows.map(toView);
+  }
+}
+
+function toView(r: Refund): RefundView {
+  return { id: r.id, amountCents: r.amountCents, reason: r.reason, createdAt: r.createdAt.toISOString() };
+}
