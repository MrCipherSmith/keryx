diff --git a/apps/orders-web/src/format/money.test.ts b/apps/orders-web/src/format/money.test.ts
new file mode 100644
index 000000000..3322e6492
--- /dev/null
+++ b/apps/orders-web/src/format/money.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { formatCents, sumCents } from "./money";
+
+describe("formatCents", () => {
+  it("formats whole and fractional amounts", () => {
+    expect(formatCents(1250, "USD")).toBe("$12.50");
+    expect(formatCents(100_000, "USD")).toBe("$1,000.00");
+  });
+
+  it("formats zero with the currency symbol", () => {
+    expect(formatCents(0, "EUR")).toBe("€0.00");
+  });
+
+  it("formats a negative amount as a refund", () => {
+    expect(formatCents(-300, "USD")).toBe("-$3.00");
+  });
+
+  it.each([12.5, Number.NaN, Number.POSITIVE_INFINITY])("rejects %s as an amount of cents", (cents) => {
+    expect(() => formatCents(cents, "USD")).toThrow(RangeError);
+  });
+});
+
+describe("sumCents", () => {
+  it("adds the amounts", () => {
+    expect(sumCents([1250, 300, -50])).toBe(1500);
+  });
+
+  it("is zero for no amounts", () => {
+    expect(sumCents([])).toBe(0);
+  });
+
+  it("rejects a fractional amount instead of rounding it", () => {
+    expect(() => sumCents([100, 0.5])).toThrow(RangeError);
+  });
+});
diff --git a/apps/orders-web/src/format/money.ts b/apps/orders-web/src/format/money.ts
new file mode 100644
index 000000000..c3ec9772e
--- /dev/null
+++ b/apps/orders-web/src/format/money.ts
@@ -0,0 +1,17 @@
+/** Formats an integer amount of minor units (cents) as a localized currency string. */
+export function formatCents(cents: number, currency: string, locale = "en-US"): string {
+  if (!Number.isSafeInteger(cents)) {
+    throw new RangeError(`cents must be a safe integer, got ${cents}`);
+  }
+  return new Intl.NumberFormat(locale, { style: "currency", currency }).format(cents / 100);
+}
+
+/** Adds up amounts in minor units, rejecting anything that is not a whole number of cents. */
+export function sumCents(values: readonly number[]): number {
+  return values.reduce((sum, cents) => {
+    if (!Number.isSafeInteger(cents)) {
+      throw new RangeError(`cents must be a safe integer, got ${cents}`);
+    }
+    return sum + cents;
+  }, 0);
+}
