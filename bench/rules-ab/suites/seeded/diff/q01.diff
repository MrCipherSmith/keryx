+describe("wiki history --runs --export", () => {
+  test("writes every run as CSV with a header row", async () => {
+    const out = await capture(() => runHistoryCommand(["--runs", "--export", "out/runs.csv"]));
+
+    expect(out.exitCode).toBe(0);
+    expect(out.stdout).toContain("exported 3 run(s)");
+    const lines = (await readFile(path.join(root, "out", "runs.csv"), "utf8")).trim().split("\n");
+    expect(lines[0]).toBe("run_id,at,pages,command");
+    expect(lines).toHaveLength(4);
+    expect(lines.some((line) => line.includes(runs[1]!.runId) && line.endsWith('"wiki collect --force"'))).toBe(true);
+  });
+
+  test("a .md target becomes a markdown table; --command filters the runs", async () => {
+    const out = await capture(() => runHistoryCommand(["--runs", "--export", "runs.md", "--command", "refresh"]));
+
+    expect(out.exitCode).toBe(0);
+    const body = await readFile(path.join(root, "runs.md"), "utf8");
+    expect(body.startsWith("| run | at | pages | command |")).toBe(true);
+    expect(body).toContain(`| ${runs[2]!.runId} |`);
+    expect(body).not.toContain(runs[0]!.runId);
+  });
+
+  test("an unknown --format or a bad --since exits 1 without writing", async () => {
+    const bad = await capture(() => runHistoryCommand(["--runs", "--export", "x.csv", "--format", "xml"]));
+    expect(bad.exitCode).toBe(1);
+    const since = await capture(() => runHistoryCommand(["--runs", "--export", "x.csv", "--since", "soon"]));
+    expect(since.exitCode).toBe(1);
+    expect(since.stderr).toContain("is not a date");
+  });
+});
