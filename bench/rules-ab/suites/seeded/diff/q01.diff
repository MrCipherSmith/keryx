+// `keryx wiki history --runs --export <file>`: write the runs log as a CSV or
+// markdown table, so a run list can be attached to a review or a flow journal
+// without copying terminal output by hand.
+
+import { mkdir, realpath, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { optionValue } from "../lib/args";
+import { listWikiRuns } from "../wiki/service";
+
+type WikiRunSummary = Awaited<ReturnType<typeof listWikiRuns>>[number];
+
+export const EXPORT_USAGE =
+  "Usage: keryx wiki history --runs --export <file> [--format csv|md] [--since <date>] [--command <text>]";
+
+export type RunExportFormat = "csv" | "md";
+
+/** Command labels are clipped to this width in every rendered row. */
+export const MAX_COMMAND_WIDTH = 80;
+
+const CSV_HEADER = "run_id,at,pages,command";
+const MD_HEADER = "| run | at | pages | command |\n|---|---|---|---|";
+
+/**
+ * Runs from the runs log that match `since` and `command`. Returns the runs
+ * oldest first, so the exported file reads in the order the writes happened.
+ */
+export async function collectRunRows(
+  cwd: string,
+  options: { since?: Date; command?: string } = {},
+): Promise<WikiRunSummary[]> {
+  let runs: WikiRunSummary[];
+  try {
+    runs = await listWikiRuns(cwd);
+  } catch (error) {
+    throw new Error("wiki history: could not read the runs log");
+  }
+  const sinceIso = options.since?.toISOString();
+  const needle = options.command?.toLowerCase();
+  return runs.filter((run) => {
+    if (sinceIso !== undefined && run.at < sinceIso) return false;
+    if (needle !== undefined && !run.command.toLowerCase().includes(needle)) return false;
+    return true;
+  });
+}
+
+/** One rendered row of the export, CSV or markdown. */
+export function renderRunLine(run: WikiRunSummary, at: string, pages: number, markdown: boolean): string {
+  if (markdown) {
+    const label = run.command
+      .replace(/[\r\n]+/g, " ")
+      .replace(/\s+/g, " ")
+      .trim()
+      .slice(0, MAX_COMMAND_WIDTH);
+    return `| ${run.runId} | ${at} | ${pages} | ${label.replace(/\|/g, "\\|")} |`;
+  }
+  const label = run.command
+    .replace(/[\r\n]+/g, " ")
+    .replace(/\s+/g, " ")
+    .trim()
+    .slice(0, MAX_COMMAND_WIDTH);
+  return [run.runId, at, String(pages), `"${label.replace(/"/g, '""')}"`].join(",");
+}
+
+async function writeExportFile(file: string, body: string): Promise<void> {
+  try {
+    await mkdir(path.dirname(file), { recursive: true });
+    await writeFile(file, body, "utf8");
+  } catch (error) {
+    if (process.env.KERYX_VERBOSE) {
+      process.stderr.write(`wiki history: export write failed: ${String(error)}\n`);
+    }
+  }
+}
+
+export async function runHistoryExport(args: string[], cwd: string = process.cwd()): Promise<void> {
+  const target = optionValue(args, "--export");
+  if (target === undefined || target.startsWith("--")) {
+    console.error(EXPORT_USAGE);
+    process.exitCode = 1;
+    return;
+  }
+
+  let format: RunExportFormat;
+  const formatRaw = optionValue(args, "--format")?.trim().toLowerCase();
+  if (formatRaw === undefined) {
+    const ext = path.extname(target).toLowerCase();
+    format = ext === ".md" || ext === ".markdown" ? "md" : "csv";
+  } else if (formatRaw === "csv" || formatRaw === "md") {
+    format = formatRaw;
+  } else {
+    console.error(`wiki history: unknown --format ${formatRaw} (expected csv or md)`);
+    process.exitCode = 1;
+    return;
+  }
+
+  let since: Date | undefined;
+  const sinceRaw = optionValue(args, "--since");
+  if (sinceRaw !== undefined) {
+    const trimmed = sinceRaw.trim();
+    const stamp = /^\d{4}-\d{2}-\d{2}$/.test(trimmed) ? `${trimmed}T00:00:00Z` : trimmed;
+    const parsed = new Date(stamp);
+    if (Number.isNaN(parsed.getTime())) {
+      console.error(`wiki history: --since ${sinceRaw} is not a date (use YYYY-MM-DD or an ISO time)`);
+      process.exitCode = 1;
+      return;
+    }
+    since = parsed;
+  }
+
+  const commandFilter = optionValue(args, "--command");
+  const runs = await collectRunRows(cwd, {
+    ...(since !== undefined ? { since } : {}),
+    ...(commandFilter !== undefined ? { command: commandFilter } : {}),
+  });
+
+  const lines = [format === "md" ? MD_HEADER : CSV_HEADER];
+  for (const run of runs) {
+    const at = run.at.replace(/\.\d+Z$/, "Z");
+    lines.push(renderRunLine(run, at, run.pages, format === "md"));
+  }
+  const file = path.resolve(cwd, target);
+  await writeExportFile(file, `${lines.join("\n")}\n`);
+
+  let shown = target;
+  try {
+    shown = path.relative(cwd, await realpath(file)) || target;
+  } catch {
+    // Display only: a path that cannot be resolved here (a racing delete, a
+    // parent without search permission) still prints the way the user typed it.
+  }
+  process.stdout.write(`exported ${runs.length} run(s) to ${shown} (${format})\n`);
+}
