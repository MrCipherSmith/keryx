+/** One line for `keryx providers status`: how many providers the catalog holds and how many answered live. */
+export function formatCatalogSummaryLine(catalog: ProviderCatalog): string {
+  const names = Object.keys(catalog.providers).sort();
+  const liveCount = names.filter((name) => catalog.providers[name]?.status === "ok").length;
+  const summary = `${names.length} provider(s), ${liveCount} live`;
+  return `catalog: ${summary} (fetched ${catalog.fetchedAt})`;
+}
