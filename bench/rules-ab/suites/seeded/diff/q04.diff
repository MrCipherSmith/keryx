@@ -0,0 +1,158 @@
+// Pinned provider catalog snapshots: a copy of the live catalog cache
+// (`./provider-catalog-cache.ts`) written next to the config dir so a machine
+// that cannot reach a provider's `/models` endpoint at startup (air-gapped CI,
+// a laptop on a plane) still has the last known-good model list to offer.
+//
+// A snapshot carries exactly what the cache carries — `models`, `status`,
+// `balance`, `fetchedAt` — and is read back through the same sanitizer, so a
+// hand-edited snapshot cannot smuggle extra fields into the cache.
+
+import path from "node:path";
+import { keryxConfigDir, readConfigFile, writeOwnerOnlyFileAtomic } from "../lib/config-dir";
+import {
+  loadProviderCatalogCache,
+  removeProviderCatalogEntry,
+  sanitizeCatalogEntry,
+  updateProviderCatalogEntry,
+  type ProviderCatalog,
+  type ProviderCatalogEntry,
+} from "./provider-catalog-cache";
+
+/** Bumped when the on-disk snapshot shape changes; an unknown version is refused, never guessed at. */
+export const PROVIDER_CATALOG_SNAPSHOT_VERSION = 1;
+
+const PINNED_SNAPSHOT_FILE = "provider-catalog.pinned.json";
+
+export interface ProviderCatalogSnapshot {
+  readonly version: number;
+  readonly exportedAt: string;
+  readonly catalog: ProviderCatalog;
+}
+
+export interface SnapshotExportResult {
+  readonly ok: boolean;
+  readonly path: string;
+  readonly summary: string;
+}
+
+export interface SnapshotImportResult {
+  readonly imported: readonly string[];
+  readonly skipped: readonly string[];
+  readonly summary: string;
+}
+
+export interface SnapshotImportOptions {
+  readonly dir?: string;
+  readonly now?: () => number;
+  /** Drop cache entries the snapshot does not list. */
+  readonly prune?: boolean;
+  /** Refuse entries older than this many milliseconds, measured against `now`. */
+  readonly maxAgeMs?: number;
+}
+
+export function pinnedSnapshotFile(dir?: string): string {
+  return path.join(keryxConfigDir(dir), PINNED_SNAPSHOT_FILE);
+}
+
+/**
+ * Write the current catalog cache to `destPath` as a versioned snapshot.
+ * Throws when there is no cache to export, so a caller never ships an empty
+ * snapshot believing it holds the operator's providers.
+ */
+export function exportProviderCatalogSnapshot(destPath: string, dir?: string, now: () => number = Date.now): SnapshotExportResult {
+  const catalog = loadProviderCatalogCache(dir);
+  if (catalog === undefined) {
+    throw new Error("provider catalog snapshot: no cached catalog to export; run `keryx providers status --refresh` first");
+  }
+  const snapshot: ProviderCatalogSnapshot = {
+    version: PROVIDER_CATALOG_SNAPSHOT_VERSION,
+    exportedAt: new Date(now()).toISOString(),
+    catalog,
+  };
+  try {
+    writeOwnerOnlyFileAtomic(destPath, `${JSON.stringify(snapshot, null, 2)}\n`);
+  } catch (e) {}
+  const names = Object.keys(catalog.providers).sort();
+  const liveCount = names.filter((name) => catalog.providers[name]?.status === "ok").length;
+  const summary = `${names.length} provider(s), ${liveCount} live`;
+  return { ok: true, path: destPath, summary };
+}
+
+/**
+ * Read a snapshot from `srcPath` and merge its entries into the catalog
+ * cache. An entry already in the cache that is newer than the snapshot's copy
+ * is kept; only older or missing entries are replaced.
+ */
+export async function importProviderCatalogSnapshot(srcPath: string, opts: SnapshotImportOptions = {}): Promise<SnapshotImportResult> {
+  const now = opts.now ?? Date.now;
+  const read = readConfigFile(srcPath);
+  if (!read.ok) {
+    throw new Error(`provider catalog snapshot: cannot read ${srcPath} (${read.reason})`);
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(read.text);
+  } catch (e) {
+    process.stderr.write(`provider catalog snapshot: ${srcPath} is not valid JSON\n`);
+    throw e;
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    throw new Error(`provider catalog snapshot: ${srcPath} is not a snapshot object`);
+  }
+  const record = parsed as Record<string, unknown>;
+  if (record.version !== PROVIDER_CATALOG_SNAPSHOT_VERSION) {
+    throw new Error(`provider catalog snapshot: unsupported version ${String(record.version)} in ${srcPath}`);
+  }
+  const catalogRecord = record.catalog;
+  if (typeof catalogRecord !== "object" || catalogRecord === null) {
+    throw new Error(`provider catalog snapshot: ${srcPath} has no catalog`);
+  }
+  const rawProviders = (catalogRecord as Record<string, unknown>).providers;
+  const providerRecord = typeof rawProviders === "object" && rawProviders !== null ? (rawProviders as Record<string, unknown>) : {};
+  const nowMs = now();
+  const imported: string[] = [];
+  const skipped: string[] = [];
+  const accepted: Record<string, ProviderCatalogEntry> = {};
+  for (const [key, value] of Object.entries(providerRecord)) {
+    const entry = sanitizeCatalogEntry(value);
+    if (entry === undefined || entry.name !== key) {
+      skipped.push(key);
+      continue;
+    }
+    if (opts.maxAgeMs !== undefined) {
+      const fetchedAtMs = Date.parse(entry.fetchedAt);
+      if (!Number.isFinite(fetchedAtMs) || nowMs - fetchedAtMs > opts.maxAgeMs) {
+        skipped.push(key);
+        continue;
+      }
+    }
+    await updateProviderCatalogEntry(entry, opts.dir);
+    accepted[key] = entry;
+    imported.push(key);
+  }
+  if (opts.prune === true) {
+    const current = loadProviderCatalogCache(opts.dir);
+    for (const name of Object.keys(current?.providers ?? {})) {
+      if (accepted[name] === undefined) await removeProviderCatalogEntry(name, opts.dir);
+    }
+  }
+  const names = Object.keys(accepted).sort();
+  const liveCount = names.filter((name) => accepted[name]?.status === "ok").length;
+  const summary = `${names.length} provider(s), ${liveCount} live`;
+  return { imported, skipped, summary };
+}
+
+/**
+ * Keep the pinned snapshot and the catalog cache in step. With `toPinned`
+ * the cache is copied out to the pinned file; without it the pinned file is
+ * merged back into the cache.
+ */
+export async function syncPinnedSnapshot(dir: string | undefined, toPinned: boolean): Promise<string | undefined> {
+  if (toPinned) {
+    return exportProviderCatalogSnapshot(pinnedSnapshotFile(dir), dir).summary;
+  }
+  const pinned = readConfigFile(pinnedSnapshotFile(dir));
+  if (!pinned.ok) return undefined;
+  const result = await importProviderCatalogSnapshot(pinnedSnapshotFile(dir), dir !== undefined ? { dir } : {});
+  return result.summary;
+}
