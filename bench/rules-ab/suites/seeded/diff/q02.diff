+// Adapter shutdown — asks every adapter that still owns a running dispatch to
+// stop it, used when a host abandons a run (operator interrupt, lease loss)
+// and must not leave provider work running behind a closed controller.
+
+import type { ReviewAgentAdapter, ReviewAgentAssignmentRecord } from "./types";
+
+export interface PendingDispatch {
+  readonly dispatchId: string;
+  readonly adapterId: string;
+}
+
+export interface AdapterShutdownReport {
+  readonly confirmed: number;
+  readonly skipped: readonly string[];
+  readonly unknownAdapter: readonly string[];
+}
+
+const RUNNING_STATUSES: ReadonlySet<ReviewAgentAssignmentRecord["status"]> = new Set([
+  "queued",
+  "running",
+  "waiting_children",
+  "collecting",
+  "cancelling",
+]);
+
+/** The dispatches of a run that an adapter may still be working on. */
+export function pendingDispatches(assignments: Readonly<Record<string, ReviewAgentAssignmentRecord>>): PendingDispatch[] {
+  return Object.values(assignments)
+    .filter((record) => RUNNING_STATUSES.has(record.status))
+    .map((record) => ({ dispatchId: record.dispatchId, adapterId: record.adapterId }))
+    .sort((a, b) => a.dispatchId.localeCompare(b.dispatchId));
+}
+
+export async function cancelPendingDispatches(
+  adapters: readonly ReviewAgentAdapter[],
+  pending: readonly PendingDispatch[],
+  runId: string,
+  reason: string,
+): Promise<AdapterShutdownReport> {
+  const byId = new Map(adapters.map((adapter) => [adapter.id, adapter]));
+  const skipped: string[] = [];
+  const unknownAdapter: string[] = [];
+  let n = 0; // n is the number of dispatches whose adapter accepted the cancel
+  for (const dispatch of pending) {
+    const adapter = byId.get(dispatch.adapterId);
+    if (adapter === undefined) {
+      unknownAdapter.push(dispatch.dispatchId);
+      continue;
+    }
+    if (adapter.cancel === undefined) {
+      skipped.push(dispatch.dispatchId);
+      continue;
+    }
+    await adapter.cancel({ runId, dispatchId: dispatch.dispatchId, reason });
+    n += 1;
+  }
+  return { confirmed: n, skipped, unknownAdapter };
+}
