{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keryx.dev/schemas/worktree-config.schema.json",
  "title": "Keryx worktree configuration (.metaproject/worktree.config.json)",
  "description": "Planned. How keryx prepares a git worktree of this project: environment files, dependency copies, named ports, local index rebuilds and the report-only test baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "envFiles": {
      "description": "Paths relative to the checkout root, copied from the main checkout by an owner-run prepare. Each must be ignored by git in the worktree or it is skipped.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^/|\\.\\.)"
        }
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dir"
        ],
        "properties": {
          "dir": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|\\.\\.)"
            }
          },
          "lockfiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(^/|\\.\\.)"
              }
            }
          },
          "install": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "env",
          "range"
        ],
        "properties": {
          "env": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              },
              {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "[low, high]; the loader also rejects low > high, which JSON Schema cannot express."
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "description": "Report-only test baseline on the flow base commit. It never gates a flow; only acceptance-layer W1 (after gate G1) may act on it."
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rebuildIndexes": {
          "type": "array",
          "items": {
            "enum": [
              "memory",
              "gdgraph",
              "wiki"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
