{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keryx.dev/schemas/worktree-config.schema.json",
  "title": "Keryx worktree configuration (.metaproject/worktree.config.json)",
  "description": "Planned. How keryx prepares a git worktree of this project: environment files, dependency copies, named ports and shared metaproject stores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "envFiles": {
      "description": "Paths relative to the checkout root copied from the home checkout. Each must be ignored by git in the worktree or it is skipped.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^/|\\.\\.)"
        }
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dir"
        ],
        "properties": {
          "dir": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|\\.\\.)"
            }
          },
          "lockfiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "install": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "env",
          "range"
        ],
        "properties": {
          "env": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              },
              {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "sharedStores": {
      "description": "\"default\" applies the policy table of the specification. An object may only turn off reading from the home checkout for a store; writes are always local.",
      "oneOf": [
        {
          "const": "default"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory": {
              "enum": [
                "home-read",
                "local"
              ]
            },
            "learning": {
              "enum": [
                "home-read",
                "local"
              ]
            },
            "reviewActive": {
              "enum": [
                "home-read",
                "local"
              ]
            }
          }
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        }
      },
      "description": "Test baseline on the flow base commit; enabled by default for flows with exec test criteria."
    }
  }
}
