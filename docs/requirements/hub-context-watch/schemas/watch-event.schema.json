{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hub context watch event",
  "description": "One event per JSON line; encoded UTF-8 length excluding newline must additionally be at most 2048 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["state"],
  "properties": {
    "state": { "enum": ["updated", "unchanged", "retrying", "busy", "fatal", "stopped"] },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "retryAfterSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "errorCode": { "enum": ["network", "timeout", "rate-limited", "server-unavailable", "cache-busy", "unauthorized", "forbidden", "permanent-http", "invalid-context", "invalid-cache", "filesystem", "index-update-failed", "configuration"] }
  }
}
