{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "automatic": {
      "type": "boolean",
      "default": false
    },
    "mode": {
      "enum": [
        "lexical",
        "hybrid"
      ],
      "default": "lexical"
    },
    "roots": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sessionArchives": {
      "type": "boolean",
      "default": false
    },
    "maxSourceBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608,
      "default": 8388608
    },
    "maxIndexBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456,
      "default": 268435456
    },
    "maxChunks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "default": 100000
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 10
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "default": 2000
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "automatic": {
            "const": true
          }
        },
        "required": [
          "automatic"
        ]
      },
      "then": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      }
    }
  ]
}
