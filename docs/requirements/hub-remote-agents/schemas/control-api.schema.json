        "machineId",
        "reportDigest",
        "receivedAt",
        "runId",
        "projectId",
        "checkoutId",
        "ledgerId",
        "daemonId",
        "expectedRunVersion",
        "observation"
      ]
    },
    "RecoveryPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
              },
              "projectId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
              },
              "checkoutId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "state": {
                "enum": [
                  "dispatching",
                  "received",
                  "starting",
                  "running",
                  "waiting-approval",
                  "paused",
                  "cancelling",
                  "succeeded",
                  "failed",
                  "cancelled",
                  "rejected",
