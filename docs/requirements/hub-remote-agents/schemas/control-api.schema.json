          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "machineId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "reportDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receivedAt": {
          "type": "string",
