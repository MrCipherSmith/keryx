{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keryx.local/schemas/hub-remote-agents/control-api.v1.json",
  "title": "Hub remote control request definitions",
  "description": "Validate a named $defs entry for its endpoint; root schema is not an endpoint validator. Encoded byte quotas and authorization are additionally enforced.",
  "$defs": {
    "PairingCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "projectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "displayName",
        "projectIds"
      ]
    },
    "EnrollmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 22,
          "maxLength": 256
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ledgerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        }
      },
      "required": [
        "code",
        "agentVersion",
        "ledgerId"
      ]
    },
    "MachineRevoke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "expectedVersion"
      ]
    },
    "StartRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machineId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "agentProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "flowId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "expectedFlowVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedInventoryVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedHeadSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$"
        },
        "specDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "criteriaDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilityDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": [
        "machineId",
        "checkoutId",
        "agentProfileId",
        "flowId",
        "expectedFlowVersion",
        "expectedInventoryVersion",
        "expectedHeadSha",
        "specDigest",
        "criteriaDigest",
        "capabilityDigest",
        "policyDigest",
        "prompt"
      ]
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRunVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "expectedRunVersion",
        "reason"
      ]
    },
    "ApprovalAnswer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRunVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actionFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "enum": [
            "allow-once",
            "deny"
          ]
        }
      },
      "required": [
        "expectedRunVersion",
        "actionFingerprint",
        "policyDigest",
        "decision"
      ]
    },
    "ResultUpload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRunVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "specDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gitBaseSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "changes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT])(?:/|$))(?!.*//)(?!.*/$)[^\\x00-\\x1f\\x7f]+$"
                  },
                  "deleted": {
                    "const": true
                  }
                },
                "required": [
                  "path",
                  "deleted"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT])(?:/|$))(?!.*//)(?!.*/$)[^\\x00-\\x1f\\x7f]+$"
                  },
                  "contentBase64": {
                    "type": "string",
                    "maxLength": 27962028,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  }
                },
                "required": [
                  "path",
                  "contentBase64",
                  "mode"
                ]
              }
            ]
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "checkId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "exitCode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "output": {
                "type": "string",
                "minLength": 0,
                "maxLength": 1048576
              }
            },
            "required": [
              "checkId",
              "command",
              "exitCode",
              "output"
            ]
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "expectedRunVersion",
        "specDigest",
        "gitBaseSha",
        "outcome",
        "partial",
        "changes",
        "checks"
      ]
    },
    "ResolveRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "expectedRunVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "localReconciliationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "decision": {
          "enum": [
            "reconciled",
            "lost"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "runId",
        "expectedRunVersion",
        "localReconciliationId",
        "decision",
        "reason"
      ]
    },
    "LocalMachinePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "hubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "checkouts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projectId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
              },
              "checkoutId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
              },
              "localBindingId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "profileIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
                },
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true
              }
            },
            "required": [
              "projectId",
              "checkoutId",
              "localBindingId",
              "path",
              "profileIds"
            ]
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "version",
        "hubId",
        "enabled",
        "maxConcurrentRuns",
        "checkouts"
      ]
    },
    "BrowserInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "resource-changed"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "resource": {
          "enum": [
            "machine",
            "run",
            "approval",
            "context"
          ]
        },
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "v",
        "type",
        "projectId",
        "resource",
        "resourceId",
        "version"
      ]
    },
    "AuthorizeCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "commandDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actionFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "runId",
        "commandDigest",
        "policyDigest"
      ]
    },
    "AuthorizationGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "commandDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorizedBy": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actionFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "grantId",
        "commandId",
        "runId",
        "commandDigest",
        "authorizedBy",
        "authorizedAt",
        "expiresAt",
        "policyDigest"
      ]
    },
    "ReconciliationReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "ledgerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "daemonId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "commandDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedRunVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "observation": {
          "enum": [
            "owned-running",
            "confirmed-stopped",
            "unknown"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "nativeIdentity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            },
            "turnId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            },
            "daemonId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            },
            "supervisorHandleId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            }
          },
          "required": [
            "sessionId",
            "turnId",
            "daemonId",
