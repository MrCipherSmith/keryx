{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keryx Metaproject OpenSpec links v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "links"],
  "properties": {
    "version": { "const": 1 },
    "links": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": { "enum": ["spec", "change"] },
              "path": { "$ref": "#/$defs/relativePath" }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": { "enum": ["wiki", "file", "module"] },
              "path": { "$ref": "#/$defs/relativePath" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\\\u0000-\\u001f\\u007f]+$"
    }
  }
}
