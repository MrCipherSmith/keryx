{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:keryx:routing:v2:classification",
  "title": "classification v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "category": {
      "enum": [
        "default",
        "review",
        "subagents",
        "quick",
        "coding",
        "planning",
        "docs",
        "unattended"
      ]
    },
    "modelClass": {
      "enum": [
        "light",
        "standard",
        "expert",
        "frontier"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "enum": [
          "tools",
          "vision",
          "structured-output"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "category",
    "modelClass",
    "confidence",
    "reasonCode",
    "requiredCapabilities"
  ]
}
