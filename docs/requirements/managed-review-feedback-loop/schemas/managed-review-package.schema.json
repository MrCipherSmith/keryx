{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keryx.local/schemas/managed-review-package.schema.json",
  "title": "Managed Review Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "mode",
    "status",
    "target",
    "artifacts",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["attach-review", "review-flow", "ingest"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "decided", "learned", "closed"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["pr", "issue", "branch", "path", "report"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "issueUrl": {
          "type": "string"
        },
        "prUrl": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "coverage",
        "report",
        "findings",
        "learning",
        "decisions"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "report": {
          "type": "string"
        },
        "findings": {
          "type": "string"
        },
        "learning": {
          "type": "string"
        },
        "decisions": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer", "status", "reason"],
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["run", "skipped", "failed", "needs_context"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "filter_stats": {
      "description": "What the round filtered (roadmap §5.1). Written by the code that does the filtering, never assembled from scope.md. Every count is an integer or null, and null ALWAYS means the stage did not run — it never means zero. A null count must have a matching row in `not_measured` giving the reason; `keryx review status` refuses a record where the two disagree. `dropped_prefilter` counts diff material (whole files and change blocks) and is deliberately not summed with the finding counts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "total",
        "dropped_prefilter",
        "dropped_low_confidence",
        "dropped_refuted",
        "retained",
        "by_reason",
        "not_measured"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "dropped_prefilter": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "dropped_low_confidence": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "dropped_refuted": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "dropped_scope_b": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "dropped_findings_cap": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "retained": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "dismissed_by_round": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "by_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "not_measured": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "reason"],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "prefilter",
                  "low_confidence",
                  "round_dismissed",
                  "refuted",
                  "scope_b",
                  "findings_cap"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "cross_family_review": {
      "description": "Which model family reviewed this round, and why (roadmap §5.4). Produced by `keryx providers cross-family --json`, recorded here by `keryx review ingest --cross-family-review <file>`, and read back and checked by `keryx review status` — a later invocation, which is the only kind of reader that catches a field nothing consumes. ABSENT MEANS NOBODY DECIDED and is never read as `single-family`. `mode: cross-family` must name a reviewer family and provider, must differ from `author_family`, and must appear among `candidates`; `mode: single-family` must leave all three reviewer fields null. `keryx review status` exits non-zero on any of those contradictions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "requested",
        "author_family",
        "reviewer_family",
        "reviewer_provider",
        "reviewer_model",
        "reason",
        "candidates"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "mode": {
          "type": "string",
          "enum": ["cross-family", "single-family"]
        },
        "requested": {
          "type": "boolean"
        },
        "author_family": {
          "type": ["string", "null"]
        },
        "reviewer_family": {
          "type": ["string", "null"]
        },
        "reviewer_provider": {
          "type": ["string", "null"]
        },
        "reviewer_model": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model", "family"],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": ["string", "null"]
              },
              "family": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
