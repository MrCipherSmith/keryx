            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "projectId",
        "createdBy",
        "createdAt",
        "kind",
        "title",
        "ownerId",
        "version",
        "state",
