{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keryx.example/schemas/hub-work-management/domain.v1.json",
  "title": "Proposed work-domain immutable content and aggregate records",
  "oneOf": [
    {
      "$ref": "#/$defs/FlowRevision"
    },
    {
      "$ref": "#/$defs/WorkFlow"
    },
    {
      "$ref": "#/$defs/IntentRevision"
    },
    {
      "$ref": "#/$defs/WorkIntent"
    },
    {
      "$ref": "#/$defs/ContextSnapshot"
    },
    {
      "$ref": "#/$defs/Attempt"
    },
    {
      "$ref": "#/$defs/ExecutionLink"
    },
    {
      "$ref": "#/$defs/ResultSubject"
    },
    {
      "$ref": "#/$defs/EvidenceRecord"
    },
    {
      "$ref": "#/$defs/ReviewSubmission"
    },
    {
      "$ref": "#/$defs/Decision"
    },
    {
      "$ref": "#/$defs/FlowSubmission"
    },
    {
      "$ref": "#/$defs/AmendmentManifest"
    }
  ],
  "$defs": {
    "DocumentRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "documentId",
        "version",
        "contentDigest"
      ]
    },
    "Criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "waivable": {
          "type": "boolean"
        }
      },
      "required": [
        "criterionId",
        "text",
        "waivable"
      ]
    },
    "Artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git"
            },
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "commitOid": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "treeOid": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pullRequest": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "observedHeadOid": {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    }
                  },
                  "required": [
                    "number",
                    "observedHeadOid"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "verification": {
              "enum": [
                "claimed",
                "observed"
              ]
            },
            "observedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "repositoryId",
            "commitOid",
            "treeOid",
            "pullRequest",
            "verification",
            "observedAt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "document"
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "documentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "documentId",
                "version",
                "contentDigest"
              ]
            },
            "proposalId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "reference",
            "proposalId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "legacy"
            },
            "revisionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "treeDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "revisionId",
            "treeDigest"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "report"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "text",
            "contentDigest"
          ]
        }
      ]
    },
    "Coverage": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "inconclusive",
              "missing"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "criterionId",
          "result",
          "evidenceIds"
        ]
      }
    },
    "FlowRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
