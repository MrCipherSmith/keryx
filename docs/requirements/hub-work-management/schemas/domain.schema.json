          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "expectedOutcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "outOfScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "specification": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "documentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "documentId",
                "version",
                "contentDigest"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "criteria": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "waivable": {
                "type": "boolean"
              }
            },
            "required": [
              "criterionId",
              "text",
              "waivable"
            ]
          }
        },
        "requiredIntentIds": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "projectId",
        "createdBy",
        "createdAt",
        "kind",
        "flowId",
        "revision",
        "problem",
        "expectedOutcome",
        "scope",
        "outOfScope",
        "specification",
        "criteria",
        "requiredIntentIds",
        "contentDigest"
      ]
    },
    "WorkFlow": {
