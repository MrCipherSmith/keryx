{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keryx.example/schemas/hub-work-management/event.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actorKind": {
      "enum": [
        "human",
        "agent",
        "machine",
        "service"
      ]
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "type": {
      "enum": [
        "flow-changed",
        "intent-changed",
        "attempt-changed",
        "context-created",
        "execution-linked",
        "subject-created",
        "evidence-recorded",
        "submission-created",
        "decision-recorded",
        "git-observed",
        "legacy-converted"
      ]
    },
    "entityType": {
      "enum": [
        "flow",
        "intent",
        "attempt",
        "context",
        "execution-link",
        "subject",
        "evidence",
        "submission",
        "decision",
        "git-observation",
        "conversion"
      ]
    },
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "entityVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "contentDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "projectId",
    "sequence",
    "eventId",
    "operationId",
    "actorId",
    "actorKind",
    "occurredAt",
    "type",
    "entityType",
    "entityId",
    "entityVersion",
    "contentDigest",
    "causationId"
  ],
  "title": "Hub work-management events, v1",
  "$comment": "Canonical protocol schema; the browser copy is generated by scripts/sync-hub-work-schemas.ts. Edit this canonical file, then regenerate the browser copies."
}
