<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Developer ID build (bundle.macOS.entitlements).
  No double hyphen may appear in this comment: codesign's XML parser (AMFI)
  rejects it, as the XML spec does, while plutil -lint accepts it.
  The bundled keryx sidecar is a compiled bun executable (bun build, compile flag):
  - allow-jit, allow-unsigned-executable-memory: JavaScriptCore's JIT maps
    writable+executable memory; the hardened runtime refuses it without these.
  - disable-library-validation: the compiled keryx extracts native libraries it
    embeds (for example the @opentui/core platform library) and dlopens them at
    run time; they are not signed by this team, so library validation would
    refuse to load them.
  desktop-release.yml checks the signed sidecar carries these and runs its version check.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
