{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for every Keryx host window and the project views in it (welcome screen and projects).",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://github.com/*/*/pull/*",
          "app": "Google Chrome"
        }
      ]
    }
  ]
}
